/-!
# Singularity at a prescribed closed point

The local analysis of the random sign form `f` at a closed point of `ℙⁿ_{𝔽ₚ}`: the degree
filtration of a finite-dimensional algebra and the monomial bases it yields, the first-order
algebra `A_P = S/𝔪_P²` at a closed point `P` of `𝔸ⁿ`, the packing of disjoint monomial bases into a
bounded degree, and the probability that the reduction `f̄` of `f` modulo `p` is singular at a
prescribed closed point of small degree.

## Main definitions

* `chartTupleDown`, `chartTupleUp`, `chartTupleEquiv`: deletion of the `i`-th entry of an exponent
  tuple, its inverse, and the resulting bijection between the exponent tuples of degree `d` in
  `n + 1` variables and those of degree at most `d` in `n` variables.
* `dehomogenize`: the substitution `x_i ↦ 1` on the standard chart `x_i ≠ 0`.
* `jetMap`: the first-order jet map `g ↦ (g(P), (∂₁g(P), …, ∂_n g(P)))` at a closed point of
  `𝔸ⁿ_k`.
* `affineHypersurfacePoint` and `affineSingularLocus`: the point of the affine hypersurface `Z(g)`
  cut out by a geometric zero of `g`, and the set of geometric points at which `Z(g)` is not
  smooth.
* `frobFixedField`: `𝔽_{p^e}`, realized inside `𝔽̄ₚ` as the subfield of roots of `x^{p^e} = x`.

## Main results

* `min_le_finrank_degreeFiltration`: the degree filtration `V_s` of a nonzero finite-dimensional
  algebra `A` over `k` generated by `y₁, …, y_m` satisfies `dim_k V_s ≥ min (s+1) (dim_k A)`.
* `exists_monomial_basis`: such an algebra has a basis of monomials in the generators of total
  degree at most `dim_k A - 1`.
* `notMem_hypersurface_map_signForm`: no point of `ℙⁿ` over `𝔽̄ₚ` with exactly one nonzero
  homogeneous coordinate lies on `X_{f̄}`.
* `exists_measurePreserving_dehomogenize_map_signForm`: on each standard chart the dehomogenization
  of `f̄` has the distribution of the affine sign polynomial `g`.
* `finrank_jetAlgebra` and `mk_sq_eq_zero_iff`: at a closed point `P` of `𝔸ⁿ` over a perfect field
  the first-order algebra `A_P = S/𝔪_P²` has dimension `(n+1) deg P` over the base field, and the
  image of `g` in it vanishes exactly when `g` and its `n` first derivatives vanish at `P`.
* `mk_sq_eq_zero_iff_mem_affineSingularLocus`: for nonzero `g`, the image of `g` in `A_P` vanishes
  exactly when the affine hypersurface `g = 0` is singular at a geometric point above `P`.
* `exists_packing_monomial_bases`: at a closed point `P` at which some coordinate function does not
  vanish, with `L = (n+1) deg P`, `K ≥ 1` and `KL ≤ d + 1`, there are `K` pairwise disjoint groups
  of `L` monomials of total degree at most `d`, each group having as image a basis of `A_P`.
* `signMeasure_mem_affineSingularLocus_affineSignPoly_le`: for such a `P` and `K`, the hypersurface
  cut out by the affine sign polynomial is singular at `P` with probability at most
  `Θ_K(p)^{(n+1) deg P}`.
* `mul_closedPointCount_le_sum_pow` and `sum_pow_le_div_mul_pow`: the number `C_e` of closed points
  of degree `e` of `ℙⁿ_{𝔽ₚ}` satisfies `e C_e ≤ 1 + p^e + ⋯ + p^{ne} ≤ (p/(p-1)) p^{ne}`.
* `signMeasure_exists_closedPoint_mem_singularLocus_le`: the union bound over the closed points of
  degree at most `R`,
  `P(∃ P, deg P ≤ R, X_{f̄} singular at P) ≤ (p/(p-1)) ∑_{e=1}^R (p^{ne}/e) Θ_{K_e}(p)^{(n+1)e}`.
-/

@[expose] public section

namespace BrowningSawin

open MvPolynomial
open scoped ENNReal

universe u

/-! ## The degree filtration of a finite-dimensional algebra -/

section Filtration

variable {k : Type*} [Field k] {A : Type*} [CommRing A] [Algebra k A] {m : ℕ}

/-- A monomial in the generators of total degree at most `s` lies in `V_s`. -/
theorem prod_pow_mem_degreeFiltration (y : Fin m → A) {e : Fin m → ℕ} {s : ℕ}
    (he : ∑ i, e i ≤ s) : ∏ i, y i ^ e i ∈ degreeFiltration k y s :=
  Submodule.subset_span ⟨e, he, rfl⟩

/-- Every step of the degree filtration contains `1`. -/
theorem one_mem_degreeFiltration (y : Fin m → A) (s : ℕ) : (1 : A) ∈ degreeFiltration k y s := by
  simpa using prod_pow_mem_degreeFiltration (k := k) y (e := 0) (s := s) (by simp)

/-- The degree filtration is increasing: `V_s ≤ V_t` for `s ≤ t`. -/
theorem degreeFiltration_mono (y : Fin m → A) {s t : ℕ} (h : s ≤ t) :
    degreeFiltration k y s ≤ degreeFiltration k y t :=
  Submodule.span_mono fun _ ⟨e, he, ha⟩ => ⟨e, he.trans h, ha⟩

/-- Multiplying a monomial by a generator raises the exponent of that generator by one. -/
theorem mul_prod_pow (y : Fin m → A) (e : Fin m → ℕ) (i : Fin m) :
    y i * ∏ j, y j ^ e j = ∏ j, y j ^ Function.update e i (e i + 1) j := by
  classical
  have h1 : ∏ j, y j ^ Function.update e i (e i + 1) j
      = y i ^ (e i + 1) * ∏ j ∈ Finset.univ.erase i, y j ^ e j := by
    rw [← Finset.mul_prod_erase Finset.univ _ (Finset.mem_univ i), Function.update_self]
    exact congrArg _ (Finset.prod_congr rfl fun j hj => by
      rw [Function.update_of_ne (Finset.ne_of_mem_erase hj)])
  rw [h1, ← Finset.mul_prod_erase Finset.univ (fun j => y j ^ e j) (Finset.mem_univ i), pow_succ]
  ring

/-- Raising the `i`-th entry of an exponent tuple by one raises its total degree by one. -/
theorem sum_update_succ (e : Fin m → ℕ) (i : Fin m) :
    ∑ j, Function.update e i (e i + 1) j = (∑ j, e j) + 1 := by
  classical
  have h1 : ∑ j, Function.update e i (e i + 1) j
      = (e i + 1) + ∑ j ∈ Finset.univ.erase i, e j := by
    rw [← Finset.add_sum_erase Finset.univ _ (Finset.mem_univ i), Function.update_self]
    exact congrArg _ (Finset.sum_congr rfl fun j hj => by
      rw [Function.update_of_ne (Finset.ne_of_mem_erase hj)])
  rw [h1, ← Finset.add_sum_erase Finset.univ e (Finset.mem_univ i)]
  omega

/-- If the degree filtration stops growing at step `s`, then `V_s` is stable under multiplication
by each generator. -/
theorem mul_mem_degreeFiltration_of_le {y : Fin m → A} {s : ℕ}
    (h : degreeFiltration k y (s + 1) ≤ degreeFiltration k y s) (i : Fin m) {v : A}
    (hv : v ∈ degreeFiltration k y s) : y i * v ∈ degreeFiltration k y s := by
  have hcomap : degreeFiltration k y s ≤
      (degreeFiltration k y s).comap (LinearMap.mulLeft k (y i)) := by
    rw [degreeFiltration, Submodule.span_le]
    rintro a ⟨e, he, rfl⟩
    refine h ?_
    simp only [LinearMap.mulLeft_apply]
    rw [mul_prod_pow]
    exact prod_pow_mem_degreeFiltration y (by rw [sum_update_succ]; omega)
  exact hcomap hv

/-- **The degree filtration grows.** For a nonzero finite-dimensional commutative algebra `A` over
a field `k`, generated by `y₁, …, y_m`, the span `V_s` of the monomials of total degree at most `s`
has dimension at least `min (s + 1) (dim_k A)`: as long as `V_s` is not all of `A` it is not stable
under multiplication by the generators, so it grows by at least one dimension at each step. -/
@[browning_sawin "lem_filtration"]
theorem min_le_finrank_degreeFiltration (k : Type*) [Field k] {A : Type*} [CommRing A]
    [Algebra k A] [Nontrivial A] [FiniteDimensional k A] {m : ℕ} {y : Fin m → A}
    (hy : Algebra.adjoin k (Set.range y) = ⊤) (s : ℕ) :
    min (s + 1) (Module.finrank k A) ≤ Module.finrank k (degreeFiltration k y s) := by
  induction s with
  | zero =>
      have hset : {a : A | ∃ e : Fin m → ℕ, ∑ i, e i ≤ 0 ∧ a = ∏ i, y i ^ e i} = {1} := by
        ext a
        simp only [Set.mem_ofPred_eq, Set.mem_singleton_iff]
        refine ⟨?_, fun ha => ⟨0, by simp, by simp [ha]⟩⟩
        rintro ⟨e, he, rfl⟩
        have : ∀ i, e i = 0 := fun i => Nat.eq_zero_of_le_zero
          ((Finset.single_le_sum (f := e) (fun _ _ => Nat.zero_le _) (Finset.mem_univ i)).trans he)
        simp [this]
      have h1 : Module.finrank k (degreeFiltration k y 0) = 1 := by
        rw [degreeFiltration, hset]
        exact finrank_span_singleton (one_ne_zero (α := A))
      rw [h1]
      exact min_le_left _ _
  | succ s ih =>
      by_cases hV : degreeFiltration k y s = ⊤
      · have htop : degreeFiltration k y (s + 1) = ⊤ :=
          top_le_iff.1 (hV ▸ degreeFiltration_mono y (Nat.le_succ s))
        rw [htop, finrank_top]
        exact min_le_right _ _
      · have hne : degreeFiltration k y s ≠ degreeFiltration k y (s + 1) := by
          intro heq
          refine hV ?_
          have hstab : degreeFiltration k y (s + 1) ≤ degreeFiltration k y s := heq ▸ le_rfl
          have key : ∀ a ∈ Algebra.adjoin k (Set.range y),
              ∀ v ∈ degreeFiltration k y s, a * v ∈ degreeFiltration k y s := by
            intro a ha
            induction ha using Algebra.adjoin_induction with
            | mem x hx =>
                obtain ⟨i, rfl⟩ := hx
                exact fun v hv => mul_mem_degreeFiltration_of_le hstab i hv
            | algebraMap r =>
                intro v hv
                rw [← Algebra.smul_def]
                exact Submodule.smul_mem _ _ hv
            | add x z _ _ ihx ihz =>
                intro v hv
                rw [add_mul]
                exact add_mem (ihx v hv) (ihz v hv)
            | mul x z _ _ ihx ihz =>
                intro v hv
                rw [mul_assoc]
                exact ihx _ (ihz v hv)
          rw [eq_top_iff]
          intro a _
          simpa using key a (hy ▸ Algebra.mem_top) 1 (one_mem_degreeFiltration y s)
        have hlt : degreeFiltration k y s < degreeFiltration k y (s + 1) :=
          lt_of_le_of_ne (degreeFiltration_mono y (Nat.le_succ s)) hne
        have := Submodule.finrank_lt_finrank_of_lt hlt
        omega

/-- Once the degree bound reaches `dim_k A`, the filtration exhausts `A`. -/
theorem degreeFiltration_eq_top [Nontrivial A] [FiniteDimensional k A] {y : Fin m → A}
    (hy : Algebra.adjoin k (Set.range y) = ⊤) {s : ℕ} (hs : Module.finrank k A ≤ s + 1) :
    degreeFiltration k y s = ⊤ := by
  have h := min_le_finrank_degreeFiltration k hy s
  have hle : Module.finrank k (degreeFiltration k y s) ≤ Module.finrank k A :=
    Submodule.finrank_le _
  exact Submodule.eq_top_of_finrank_eq (le_antisymm hle (by omega))

/-- **A monomial basis of bounded degree.** A nonzero finite-dimensional commutative algebra `A`
over a field `k`, generated by `y₁, …, y_m`, has a basis consisting of the images of monomials in
the generators of total degree at most `dim_k A - 1`: the filtration exhausts `A` at that degree by
`min_le_finrank_degreeFiltration`, and a basis can be selected from any spanning set. -/
@[browning_sawin "lem_monomial_basis"]
theorem exists_monomial_basis (k : Type*) [Field k] {A : Type*} [CommRing A] [Algebra k A]
    [Nontrivial A] [FiniteDimensional k A] {m : ℕ} {y : Fin m → A}
    (hy : Algebra.adjoin k (Set.range y) = ⊤) :
    ∃ B : Set (Fin m → ℕ), (∀ e ∈ B, ∑ i, e i ≤ Module.finrank k A - 1) ∧
      ∃ b : Module.Basis ↥B k A, ∀ e : ↥B, b e = ∏ i, y i ^ (e : Fin m → ℕ) i := by
  classical
  have hpos : 0 < Module.finrank k A := Module.finrank_pos
  have hspanT : Submodule.span k
      {a : A | ∃ e : Fin m → ℕ, ∑ i, e i ≤ Module.finrank k A - 1 ∧ a = ∏ i, y i ^ e i} = ⊤ :=
    degreeFiltration_eq_top hy (by omega)
  obtain ⟨c, hcT, hcspan, hcli⟩ := exists_linearIndependent k
    {a : A | ∃ e : Fin m → ℕ, ∑ i, e i ≤ Module.finrank k A - 1 ∧ a = ∏ i, y i ^ e i}
  choose! f hf1 hf2 using fun x (hx : x ∈ c) => hcT hx
  have hmono : ∀ e ∈ f '' c, ∏ i, y i ^ e i ∈ c := by
    rintro e ⟨x, hx, rfl⟩
    rw [← hf2 x hx]
    exact hx
  refine ⟨f '' c, ?_, ?_⟩
  · rintro e ⟨x, hx, rfl⟩
    exact hf1 x hx
  · have hginj : Function.Injective fun e : ↥(f '' c) => ∏ i, y i ^ (e : Fin m → ℕ) i := by
      rintro ⟨e, he⟩ ⟨e', he'⟩ hee
      obtain ⟨x, hx, rfl⟩ := he
      obtain ⟨x', hx', rfl⟩ := he'
      simp only at hee
      rw [← hf2 x hx, ← hf2 x' hx'] at hee
      simp [hee]
    have hli : LinearIndependent k fun e : ↥(f '' c) => ∏ i, y i ^ (e : Fin m → ℕ) i :=
      hcli.comp (fun e : ↥(f '' c) => (⟨∏ i, y i ^ (e : Fin m → ℕ) i, hmono e e.2⟩ : ↥c))
        fun e e' hee => hginj (by simpa using hee)
    have hrange : (Set.range fun e : ↥(f '' c) => ∏ i, y i ^ (e : Fin m → ℕ) i) = c := by
      refine Set.Subset.antisymm ?_ fun x hx => ⟨⟨f x, ⟨x, hx, rfl⟩⟩, (hf2 x hx).symm⟩
      rintro _ ⟨e, rfl⟩
      exact hmono e e.2
    exact ⟨Module.Basis.mk hli (by rw [hrange, hcspan, hspanT]),
      fun e => Module.Basis.mk_apply hli _ e⟩

end Filtration

/-! ## No coordinate vertex lies on the hypersurface -/

section NoVertex

variable {p : ℕ} [Fact p.Prime] {n d : ℕ}

/-- The value of the reduction of the random sign form at a point of affine `(n+1)`-space, term by
term. -/
theorem eval_map_signForm (ε : SignFamily (monomialsEq (n + 1) d)) {K : Type*} [Field K]
    (φ : ℤ →+* K) (a : Fin (n + 1) → K) :
    eval a ((signForm n d ε).map φ)
      = ∑ α ∈ monomialsEq (n + 1) d, φ (signOf ε α : ℤ) * ∏ j, a j ^ α j := by
  rw [signForm, map_sum, map_sum]
  exact Finset.sum_congr rfl fun α _ => by
    rw [MvPolynomial.map_monomial, eval_monomial_eq_mul_prod]

/-- **No coordinate vertex is on the hypersurface.** A point of `ℙⁿ` over `𝔽̄ₚ` with exactly one
nonzero homogeneous coordinate — the `i`-th, say — does not lie on `X_{f̄}`: every monomial of the
random sign form but the pure power `x_i^d` vanishes there, so the value is the reduction of the
sign `ε_{d e_i}`, which is a unit. (No parity assumption on `p` is needed: `±1` is nonzero in every
field of positive characteristic `p > 1`.) -/
@[browning_sawin "lem_no_vertex"]
theorem notMem_hypersurface_map_signForm (ε : SignFamily (monomialsEq (n + 1) d))
    {P : Projectivization (AlgebraicClosure (ZMod p)) (Fin (n + 1) → AlgebraicClosure (ZMod p))}
    {i : Fin (n + 1)} (hP : ∀ j, j ≠ i → P.rep j = 0) :
    P ∉ hypersurface ((signForm n d ε).map (Int.castRingHom (ZMod p))) := by
  classical
  have hai : P.rep i ≠ 0 := by
    intro h
    refine P.rep_nonzero (funext fun j => ?_)
    by_cases hj : j = i
    · rw [hj]; exact h
    · exact hP j hj
  have hmap : toClosure ((signForm n d ε).map (Int.castRingHom (ZMod p)))
      = (signForm n d ε).map (Int.castRingHom (AlgebraicClosure (ZMod p))) := by
    rw [toClosure, MvPolynomial.map_map]
    congr 1
  intro hmem
  rw [hypersurface, Set.mem_ofPred_eq, hmap, eval_map_signForm] at hmem
  have hmemα : (Finsupp.single i d : Fin (n + 1) →₀ ℕ) ∈ monomialsEq (n + 1) d :=
    mem_monomialsEq.2 (Finsupp.degree_single i d)
  have hzero : ∀ α ∈ monomialsEq (n + 1) d, α ≠ Finsupp.single i d →
      (Int.castRingHom (AlgebraicClosure (ZMod p))) (signOf ε α : ℤ) *
        ∏ j, P.rep j ^ α j = 0 := by
    intro α hα hne
    have hd : α.degree = d := mem_monomialsEq.1 hα
    obtain ⟨j, hj, hjne⟩ : ∃ j, j ≠ i ∧ α j ≠ 0 := by
      by_contra hcon
      push Not at hcon
      have heq : α = Finsupp.single i (α i) := by
        refine Finsupp.ext fun j => ?_
        by_cases hj : j = i
        · simp [hj]
        · rw [hcon j hj, Finsupp.single_apply, ite_eq_right (Ne.symm hj)]
      have hdi : α i = d := by
        rw [← hd, heq, Finsupp.degree_single, Finsupp.single_eq_same]
      exact hne (by rw [heq, hdi])
    rw [Finset.prod_eq_zero (Finset.mem_univ j) (by rw [hP j hj, zero_pow hjne]), mul_zero]
  rw [Finset.sum_eq_single_of_mem _ hmemα hzero] at hmem
  have hprod : ∏ j, P.rep j ^ (Finsupp.single i d : Fin (n + 1) →₀ ℕ) j = P.rep i ^ d := by
    refine Finset.prod_eq_single_of_mem i (Finset.mem_univ i) ?_ |>.trans (by simp)
    intro j _ hj
    simp [Ne.symm hj]
  rw [hprod] at hmem
  rcases mul_eq_zero.1 hmem with h | h
  · rcases Int.units_eq_one_or (signOf ε (Finsupp.single i d)) with hu | hu <;>
      rw [hu] at h <;> simp at h
  · exact absurd h (pow_ne_zero d hai)

end NoVertex

/-! ## Dehomogenization on a standard chart

Setting `x_i = 1` turns a form of degree `d` in `x₀, …, x_n` into a polynomial of degree at most
`d` in the remaining `n` variables, and the induced map on exponent tuples `α ↦ (α_j)_{j ≠ i}` is a
bijection from the tuples of degree `d` onto the tuples of degree at most `d`. -/

section Dehomogenization

variable {n : ℕ}

/-- The exponent tuple of the monomial that `x^α` becomes on the chart `x_i ≠ 0`: the tuple `α`
with its `i`-th entry deleted. -/
noncomputable def chartTupleDown (i : Fin (n + 1)) (α : Fin (n + 1) →₀ ℕ) : Fin n →₀ ℕ :=
  Finsupp.equivFunOnFinite.symm (Fin.removeNth i α)

/-- The inverse of `chartTupleDown` on the tuples of degree `d`: insert `d - |β|` in position
`i`. -/
noncomputable def chartTupleUp (d : ℕ) (i : Fin (n + 1)) (β : Fin n →₀ ℕ) : Fin (n + 1) →₀ ℕ :=
  Finsupp.equivFunOnFinite.symm (Fin.insertNth i (d - β.degree) β)

/-- The `j`-th entry of `chartTupleDown i α` is the entry of `α` in the `j`-th position other than
`i`. -/
@[simp]
theorem chartTupleDown_apply (i : Fin (n + 1)) (α : Fin (n + 1) →₀ ℕ) (j : Fin n) :
    chartTupleDown i α j = α (i.succAbove j) := rfl

/-- The `i`-th entry of `chartTupleUp d i β` is `d - |β|`. -/
@[simp]
theorem chartTupleUp_apply_self (d : ℕ) (i : Fin (n + 1)) (β : Fin n →₀ ℕ) :
    chartTupleUp d i β i = d - β.degree := by
  simp [chartTupleUp]

/-- Away from position `i`, the entries of `chartTupleUp d i β` are those of `β`. -/
@[simp]
theorem chartTupleUp_apply_succAbove (d : ℕ) (i : Fin (n + 1)) (β : Fin n →₀ ℕ) (j : Fin n) :
    chartTupleUp d i β (i.succAbove j) = β j := by
  simp [chartTupleUp]

/-- Deleting the `i`-th entry drops the total degree by that entry. -/
theorem add_degree_chartTupleDown (i : Fin (n + 1)) (α : Fin (n + 1) →₀ ℕ) :
    α i + (chartTupleDown i α).degree = α.degree := by
  rw [Finsupp.degree_eq_sum, Finsupp.degree_eq_sum, Fin.sum_univ_succAbove (fun j => α j) i]
  simp

/-- For `|β| ≤ d` the tuple `chartTupleUp d i β` has total degree exactly `d`. -/
theorem degree_chartTupleUp {d : ℕ} (i : Fin (n + 1)) {β : Fin n →₀ ℕ} (h : β.degree ≤ d) :
    (chartTupleUp d i β).degree = d := by
  rw [Finsupp.degree_eq_sum, Fin.sum_univ_succAbove (fun j => chartTupleUp d i β j) i]
  simp only [chartTupleUp_apply_self, chartTupleUp_apply_succAbove]
  rw [← Finsupp.degree_eq_sum]
  omega

/-- Inserting an entry in position `i` and deleting it again recovers the original tuple. -/
theorem chartTupleDown_chartTupleUp {d : ℕ} (i : Fin (n + 1)) (β : Fin n →₀ ℕ) :
    chartTupleDown i (chartTupleUp d i β) = β :=
  Finsupp.ext fun j => by simp

/-- On the tuples of total degree `d`, deleting the `i`-th entry and inserting it again recovers
the original tuple. -/
theorem chartTupleUp_chartTupleDown {d : ℕ} (i : Fin (n + 1)) {α : Fin (n + 1) →₀ ℕ}
    (h : α.degree = d) : chartTupleUp d i (chartTupleDown i α) = α := by
  refine Finsupp.ext fun j => ?_
  rcases eq_or_ne j i with h1 | hj
  · rw [h1, chartTupleUp_apply_self]
    have := add_degree_chartTupleDown i α
    omega
  · obtain ⟨j', rfl⟩ := Fin.exists_succAbove_eq hj
    simp

/-- Deleting the `i`-th entry is a bijection from the exponent tuples of degree `d` in `n + 1`
variables onto those of degree at most `d` in `n` variables. -/
noncomputable def chartTupleEquiv (d : ℕ) (i : Fin (n + 1)) :
    ↥(monomialsEq (n + 1) d) ≃ ↥(monomialsLE n d) where
  toFun α := ⟨chartTupleDown i α, mem_monomialsLE.2 (by
    have := add_degree_chartTupleDown i α.1
    have h := mem_monomialsEq.1 α.2
    omega)⟩
  invFun β :=
    ⟨chartTupleUp d i β, mem_monomialsEq.2 (degree_chartTupleUp i (mem_monomialsLE.1 β.2))⟩
  left_inv α := Subtype.ext (chartTupleUp_chartTupleDown i (mem_monomialsEq.1 α.2))
  right_inv β := Subtype.ext (chartTupleDown_chartTupleUp i β.1)

/-- Dehomogenization on the standard chart `x_i ≠ 0`: the substitution `x_i ↦ 1` and
`x_{σ_i(j)} ↦ y_j`, where `σ_i` lists the remaining variables in order. -/
noncomputable def dehomogenize (R : Type*) [CommRing R] (i : Fin (n + 1)) :
    MvPolynomial (Fin (n + 1)) R →ₐ[R] MvPolynomial (Fin n) R :=
  aeval (Fin.insertNth i 1 X)

/-- Dehomogenization sends the monomial `x^α` to `y^β` with `β = α` less its `i`-th entry: no two
monomials are combined, and no coefficient is changed. -/
theorem dehomogenize_monomial (R : Type*) [CommRing R] (i : Fin (n + 1)) (α : Fin (n + 1) →₀ ℕ)
    (r : R) : dehomogenize R i (monomial α r) = monomial (chartTupleDown i α) r := by
  have hprod : ∏ j : Fin (n + 1), (Fin.insertNth i (1 : MvPolynomial (Fin n) R) X) j ^ α j
      = ∏ j : Fin n, X j ^ (chartTupleDown i α) j := by
    rw [Fin.prod_univ_succAbove _ i]
    simp
  rw [dehomogenize, aeval_monomial, Finsupp.prod_fintype _ _ (fun _ => pow_zero _), hprod,
    monomial_eq_C_mul_prod_X_pow]
  simp [algebraMap_eq]

end Dehomogenization

/-! ## The dehomogenized random sign form -/

section DehomogModel

open MeasureTheory

variable {p : ℕ} [Fact p.Prime] {n d : ℕ}

/-- Reindexing a family of independent uniform signs along a bijection of index sets again yields a
family of independent uniform signs: both laws are uniform, and the two index types have the same
number of sign families. -/
theorem measurePreserving_signFamilyCongr {ι ι' : Type*} [Fintype ι] [DecidableEq ι] [Fintype ι']
    [DecidableEq ι'] (e : ι ≃ ι') :
    MeasurePreserving (e.arrowCongr (Equiv.refl ℤˣ)) (signMeasure ι) (signMeasure ι') := by
  set Φ := e.arrowCongr (Equiv.refl ℤˣ) with hΦ
  refine ⟨Measurable.of_discrete, MeasureTheory.Measure.ext_of_singleton fun ε => ?_⟩
  have hpre : Φ ⁻¹' {ε} = {Φ.symm ε} := by
    ext x
    simp [Equiv.eq_symm_apply]
  rw [Measure.map_apply Measurable.of_discrete (measurableSet_singleton ε), hpre]
  simp only [signMeasure]
  rw [PMF.toMeasure_apply_singleton _ _ (measurableSet_singleton _),
    PMF.toMeasure_apply_singleton _ _ (measurableSet_singleton _), PMF.uniformOfFintype_apply,
    PMF.uniformOfFintype_apply, Fintype.card_congr Φ]

/-- On the chart `x_i ≠ 0` the reduction modulo `p` of the random sign form dehomogenizes to the
affine sign polynomial whose signs are those of `f`, reindexed along `chartTupleEquiv`. -/
theorem dehomogenize_map_signForm (i : Fin (n + 1)) (ε : SignFamily (monomialsEq (n + 1) d)) :
    dehomogenize (ZMod p) i ((signForm n d ε).map (Int.castRingHom (ZMod p)))
      = affineSignPoly p n d ((chartTupleEquiv d i).arrowCongr (Equiv.refl ℤˣ) ε) := by
  classical
  rw [signForm, map_sum, map_sum, affineSignPoly]
  refine Finset.sum_nbij' (chartTupleDown i) (chartTupleUp d i)
    (fun α hα => (chartTupleEquiv d i ⟨α, hα⟩).2) (fun β hβ => ((chartTupleEquiv d i).symm
      ⟨β, hβ⟩).2) (fun α hα => chartTupleUp_chartTupleDown i (mem_monomialsEq.1 hα))
    (fun β _ => chartTupleDown_chartTupleUp i β) fun α hα => ?_
  rw [MvPolynomial.map_monomial, dehomogenize_monomial]
  congr 1
  have hmem : chartTupleDown i α ∈ monomialsLE n d := (chartTupleEquiv d i ⟨α, hα⟩).2
  rw [signOf_of_mem _ hmem, signOf_of_mem _ hα]
  have : (chartTupleEquiv d i).symm ⟨chartTupleDown i α, hmem⟩ = ⟨α, hα⟩ :=
    Subtype.ext (chartTupleUp_chartTupleDown i (mem_monomialsEq.1 hα))
  simp only [Equiv.arrowCongr_apply, Equiv.coe_refl, Function.comp_apply, id_eq, this]
  simp

/-- **Dehomogenization preserves the model.** On any standard chart `x_i ≠ 0`, the dehomogenization
of the reduction modulo `p` of the random sign form `f` has the distribution of the affine sign
polynomial `g`: deleting the `i`-th exponent is a bijection from the tuples of degree `d` onto the
tuples of degree at most `d`, so it neither combines two monomials nor changes a coefficient, and
reindexing an independent family of uniform signs along a bijection again gives one. -/
@[browning_sawin "lem_dehomog_model"]
theorem exists_measurePreserving_dehomogenize_map_signForm (i : Fin (n + 1)) :
    ∃ Φ : SignFamily (monomialsEq (n + 1) d) ≃ SignFamily (monomialsLE n d),
      MeasurePreserving Φ (signMeasure ↥(monomialsEq (n + 1) d)) (signMeasure ↥(monomialsLE n d)) ∧
      ∀ ε, dehomogenize (ZMod p) i ((signForm n d ε).map (Int.castRingHom (ZMod p)))
        = affineSignPoly p n d (Φ ε) :=
  ⟨(chartTupleEquiv d i).arrowCongr (Equiv.refl ℤˣ),
    measurePreserving_signFamilyCongr _, dehomogenize_map_signForm i⟩

end DehomogModel

/-! ## The first-order algebra at a closed point

A closed point of `𝔸ⁿ_k` is presented here by a surjection `φ : k[y₁, …, y_n] → κ` onto a field,
`𝔪` being its kernel. The two hypotheses on `κ` — finite dimensional over `k`, and separable over
`k` — are exactly what the residue field at a closed point of `𝔸ⁿ` over a perfect field
satisfies. -/

section Jet

variable {k : Type*} [Field k] {n : ℕ} {κ : Type*} [Field κ] [Algebra k κ]

set_option maxRecDepth 8000 in
/-- **The first derivatives at a closed point span.** At a closed point of `𝔸ⁿ_k` with separable
residue field `κ`, every vector `c ∈ κⁿ` is the vector of first derivatives at the point of some
element of `𝔪`. Otherwise those vectors would lie in a hyperplane `∑ cᵢ tᵢ = 0` with `c ≠ 0`, and
`g ↦ ∑ cᵢ ∂ᵢg(P)` would be a `k`-derivation of `k[y]` into `κ` vanishing on `𝔪`, hence induced by a
`k`-derivation of `κ`; there is none, `κ/k` being separable, and evaluating at `yᵢ` gives
`cᵢ = 0`. -/
theorem exists_mem_ker_forall_pderiv_eq [Module.Finite k κ] [Algebra.IsSeparable k κ]
    (φ : MvPolynomial (Fin n) k →ₐ[k] κ) (hφ : Function.Surjective φ) (c : Fin n → κ) :
    ∃ g, φ g = 0 ∧ ∀ i, φ (pderiv i g) = c i := by
  classical
  have : Algebra.FormallyUnramified k κ := Algebra.FormallyUnramified.of_isSeparable k κ
  set W : Submodule κ (Fin n → κ) :=
    { carrier := {v | ∃ g, φ g = 0 ∧ ∀ i, φ (pderiv i g) = v i}
      add_mem' := by
        rintro u v ⟨g, hg, hg'⟩ ⟨h, hh, hh'⟩
        exact ⟨g + h, by simp [hg, hh], fun i => by simp [hg', hh']⟩
      zero_mem' := ⟨0, by simp, by simp⟩
      smul_mem' := by
        rintro a v ⟨g, hg, hg'⟩
        obtain ⟨b, hb⟩ := hφ a
        refine ⟨b * g, by simp [hg], fun i => ?_⟩
        rw [Derivation.leibniz]
        simp [hg, hg', hb] } with hWdef
  suffices h : W = ⊤ by
    have hc : c ∈ W := h ▸ Submodule.mem_top
    exact hc
  by_contra hW
  obtain ⟨f, hf0, hfW⟩ :=
    Submodule.exists_dual_map_eq_bot_of_lt_top (lt_top_iff_ne_top.2 hW) inferInstance
  set a : Fin n → κ := fun i => f (Pi.single i 1) with ha
  have hfv : ∀ v : Fin n → κ, f v = ∑ i, v i * a i := by
    intro v
    have hv : v = ∑ i, Pi.single i (v i) := (Finset.univ_sum_single v).symm
    rw [hv, map_sum]
    refine Finset.sum_congr rfl fun i _ => ?_
    have h1 : Pi.single i (v i) = v i • Pi.single i (1 : κ) := by
      ext j; by_cases hj : j = i <;> simp [hj]
    rw [h1, map_smul, ha]
    simp [smul_eq_mul]
  have hann : ∀ v ∈ W, f v = 0 := by
    intro v hv
    have h1 : f v ∈ Submodule.map f W := Submodule.mem_map_of_mem hv
    rw [hfW, Submodule.mem_bot] at h1
    exact h1
  set δ : MvPolynomial (Fin n) k →ₗ[k] κ :=
    { toFun := fun g => ∑ i, φ (pderiv i g) * a i
      map_add' := by intro g h; simp [add_mul, Finset.sum_add_distrib]
      map_smul' := by intro r g; simp [Finset.smul_sum] } with hδdef
  have hδapply : ∀ g, δ g = ∑ i, φ (pderiv i g) * a i := fun g => rfl
  have hδker : ∀ g, φ g = 0 → δ g = 0 := by
    intro g hg
    have hmem : (fun i => φ (pderiv i g)) ∈ W := ⟨g, hg, fun i => rfl⟩
    have h2 := hann _ hmem
    rw [hfv] at h2
    rw [hδapply]
    exact h2
  have hδwell : ∀ g h : MvPolynomial (Fin n) k, φ g = φ h → δ g = δ h := by
    intro g h hgh
    have h2 : δ (g - h) = 0 := hδker _ (by simp [hgh])
    rw [map_sub, sub_eq_zero] at h2
    exact h2
  have hleibδ : ∀ g h, δ (g * h) = φ g * δ h + φ h * δ g := by
    intro g h
    rw [hδapply, hδapply, hδapply, Finset.mul_sum, Finset.mul_sum, ← Finset.sum_add_distrib]
    refine Finset.sum_congr rfl fun i _ => ?_
    rw [Derivation.leibniz]
    simp only [smul_eq_mul, map_add, map_mul]
    ring
  obtain ⟨σ, hσ⟩ := hφ.hasRightInverse
  set D : κ →ₗ[k] κ :=
    { toFun := fun x => δ (σ x)
      map_add' := by
        intro x y
        rw [hδwell (σ (x + y)) (σ x + σ y) (by simp [hσ x, hσ y, hσ (x + y)]), map_add]
      map_smul' := by
        intro r x
        simp only [RingHom.id_apply]
        rw [hδwell (σ (r • x)) (r • σ x) (by simp [hσ x, hσ (r • x)]), map_smul] } with hDdef
  have hleibD : ∀ x y : κ, D (x * y) = x • D y + y • D x := by
    intro x y
    change δ (σ (x * y)) = x • δ (σ y) + y • δ (σ x)
    rw [hδwell (σ (x * y)) (σ x * σ y) (by simp [hσ x, hσ y, hσ (x * y)]), hleibδ, hσ, hσ]
    simp [smul_eq_mul]
  set DD : Derivation k κ κ := Derivation.mk' D hleibD with hDD
  have hDzero : ∀ x, DD x = 0 := by
    intro x
    have h1 : DD.liftKaehlerDifferential (KaehlerDifferential.D k κ x) = DD x :=
      DFunLike.congr_fun (Derivation.liftKaehlerDifferential_comp DD) x
    have h2 : KaehlerDifferential.D k κ x = 0 := Subsingleton.elim _ _
    rw [h2, map_zero] at h1
    exact h1.symm
  have hazero : ∀ i, a i = 0 := by
    intro i
    have h1 : DD (φ (X i)) = 0 := hDzero _
    have h2 : DD (φ (X i)) = δ (X i) := by
      change δ (σ (φ (X i))) = δ (X i)
      exact hδwell _ _ (by rw [hσ])
    rw [h2, hδapply] at h1
    rw [Finset.sum_eq_single_of_mem i (Finset.mem_univ i)
      (fun j _ hj => by rw [pderiv_X_of_ne (Ne.symm hj)]; simp)] at h1
    simpa using h1
  exact hf0 (LinearMap.ext fun v => by rw [hfv]; simp [hazero])

/-- The **first-order jet map** at a closed point of `𝔸ⁿ_k` presented by `φ : k[y₁,…,y_n] → κ`: it
records the value of a polynomial at the point together with the values of its `n` first partial
derivatives. -/
noncomputable def jetMap (φ : MvPolynomial (Fin n) k →ₐ[k] κ) :
    MvPolynomial (Fin n) k →ₗ[k] κ × (Fin n → κ) :=
  φ.toLinearMap.prod (LinearMap.pi fun i => φ.toLinearMap ∘ₗ (pderiv i).toLinearMap)

/-- The jet map sends `g` to its value at the point together with the values of its `n` first
partial derivatives. -/
@[simp]
theorem jetMap_apply (φ : MvPolynomial (Fin n) k →ₐ[k] κ) (g : MvPolynomial (Fin n) k) :
    jetMap φ g = (φ g, fun i => φ (pderiv i g)) := rfl

/-- The jet map kills `𝔪²`: a product of two elements of `𝔪` vanishes at the point, and so does
each of its first derivatives by the Leibniz rule. -/
theorem jetMap_eq_zero_of_mem_sq {𝔪 : Ideal (MvPolynomial (Fin n) k)}
    (φ : MvPolynomial (Fin n) k →ₐ[k] κ)
    (hker : RingHom.ker (φ : MvPolynomial (Fin n) k →+* κ) = 𝔪)
    {g : MvPolynomial (Fin n) k} (hg : g ∈ 𝔪 ^ 2) : jetMap φ g = 0 := by
  have hmem : ∀ x : MvPolynomial (Fin n) k, x ∈ 𝔪 → φ x = 0 := fun x hx => by
    rw [← hker] at hx; exact hx
  rw [pow_two 𝔪] at hg
  refine Submodule.mul_induction_on hg ?_ ?_
  · intro x hx y hy
    rw [jetMap_apply, Prod.ext_iff]
    refine ⟨by simp [map_mul, hmem x hx], funext fun i => ?_⟩
    change φ (pderiv i (x * y)) = 0
    rw [Derivation.leibniz]
    simp [hmem x hx, hmem y hy]
  · intro x y hx hy
    rw [map_add, hx, hy, add_zero]

/-- The jet map is surjective: the value can be prescribed because `φ` is, and the derivatives can
then be corrected by an element of `𝔪` thanks to `exists_mem_ker_forall_pderiv_eq`. -/
theorem surjective_jetMap [Module.Finite k κ] [Algebra.IsSeparable k κ]
    (φ : MvPolynomial (Fin n) k →ₐ[k] κ) (hφ : Function.Surjective φ) :
    Function.Surjective (jetMap φ) := by
  rintro ⟨c, m⟩
  obtain ⟨g₀, hg₀⟩ := hφ c
  obtain ⟨g₁, h₁, h₁'⟩ :=
    exists_mem_ker_forall_pderiv_eq φ hφ (fun i => m i - φ (pderiv i g₀))
  refine ⟨g₀ + g₁, ?_⟩
  rw [jetMap_apply, Prod.ext_iff]
  refine ⟨by simp [hg₀, h₁], funext fun i => ?_⟩
  simp [h₁' i]

set_option maxHeartbeats 1000000 in
-- The `κ`-algebra structure transported along the étale section makes the elaboration of the
-- spanning argument below expensive; the default budget is not enough for it.
/-- **The first-order algebra is finite of dimension at most `(n+1)[κ : k]`.** The residue map
`A_P → κ` has square-zero kernel, so separability of `κ/k` provides an algebra section `κ → A_P`;
against it `A_P` is spanned by `1` and the `n` elements `yᵢ - aᵢ`, because the products of any two
of the latter vanish. -/
theorem finite_and_finrank_quotient_sq_le [Module.Finite k κ] [Algebra.IsSeparable k κ]
    {𝔪 : Ideal (MvPolynomial (Fin n) k)} (φ : MvPolynomial (Fin n) k →ₐ[k] κ)
    (hφ : Function.Surjective φ) (hker : RingHom.ker (φ : MvPolynomial (Fin n) k →+* κ) = 𝔪) :
    Module.Finite k (MvPolynomial (Fin n) k ⧸ 𝔪 ^ 2) ∧
      Module.finrank k (MvPolynomial (Fin n) k ⧸ 𝔪 ^ 2) ≤ (n + 1) * Module.finrank k κ := by
  classical
  have : Algebra.FormallyEtale k κ := Algebra.FormallyEtale.of_isSeparable k κ
  have hmem𝔪 : ∀ g : MvPolynomial (Fin n) k, φ g = 0 ↔ g ∈ 𝔪 := by
    intro g; rw [← hker]; exact Iff.rfl
  have hφ2 : ∀ x ∈ 𝔪 ^ 2, φ x = 0 := by
    intro x hx
    rw [pow_two 𝔪] at hx
    refine Submodule.mul_induction_on hx ?_ ?_
    · intro y hy z _
      rw [map_mul, (hmem𝔪 y).2 hy, zero_mul]
    · intro y z hy hz; rw [map_add, hy, hz, add_zero]
  set A := MvPolynomial (Fin n) k ⧸ 𝔪 ^ 2 with hA
  set q : A →ₐ[k] κ := Ideal.Quotient.liftₐ (𝔪 ^ 2) φ hφ2 with hq
  have hqmk : ∀ g, q (Ideal.Quotient.mk (𝔪 ^ 2) g) = φ g := fun g => rfl
  have hqsurj : Function.Surjective q := by
    intro c
    obtain ⟨g, hg⟩ := hφ c
    exact ⟨Ideal.Quotient.mk _ g, by rw [hqmk, hg]⟩
  have hkerq : RingHom.ker (q : A →+* κ) ^ 2 = ⊥ := by
    rw [pow_two (RingHom.ker (q : A →+* κ)), eq_bot_iff]
    refine Submodule.mul_le.2 ?_
    intro x hx y hy
    obtain ⟨x', rfl⟩ := Ideal.Quotient.mk_surjective x
    obtain ⟨y', rfl⟩ := Ideal.Quotient.mk_surjective y
    have hx' : x' ∈ 𝔪 := (hmem𝔪 x').1 (by simpa [hqmk] using hx)
    have hy' : y' ∈ 𝔪 := (hmem𝔪 y').1 (by simpa [hqmk] using hy)
    have hxy : x' * y' ∈ 𝔪 ^ 2 := by rw [pow_two 𝔪]; exact Ideal.mul_mem_mul hx' hy'
    simp only [Submodule.mem_bot, ← map_mul]
    exact (Ideal.Quotient.eq_zero_iff_mem).2 hxy
  have hnil : IsNilpotent (RingHom.ker (q : A →+* κ)) := ⟨2, hkerq⟩
  have hmulzero : ∀ x y : A, q x = 0 → q y = 0 → x * y = 0 := by
    intro x y hx hy
    have hm : x * y ∈ RingHom.ker (q : A →+* κ) ^ 2 := by
      rw [pow_two (RingHom.ker (q : A →+* κ))]
      exact Ideal.mul_mem_mul hx hy
    rw [hkerq] at hm
    simpa using hm
  set s : κ →ₐ[k] A :=
    Algebra.FormallySmooth.liftOfSurjective (AlgHom.id k κ) q hqsurj hnil with hs
  have hqs : ∀ c, q (s c) = c :=
    fun c => DFunLike.congr_fun
      (Algebra.FormallySmooth.comp_liftOfSurjective (AlgHom.id k κ) q hqsurj hnil) c
  let : Algebra κ A := (s : κ →+* A).toAlgebra
  have : IsScalarTower k κ A := IsScalarTower.of_algebraMap_eq fun x => by
    change algebraMap k A x = s (algebraMap k κ x)
    rw [AlgHom.commutes]
  have halg : ∀ c : κ, algebraMap κ A c = s c := fun c => rfl
  set w : Fin (n + 1) → A :=
    Fin.cons 1 (fun i => Ideal.Quotient.mk (𝔪 ^ 2) (X i) - s (φ (X i))) with hw
  have hw0 : w 0 = 1 := by rw [hw]; exact Fin.cons_zero _ _
  have hwsucc : ∀ i : Fin n, w i.succ = Ideal.Quotient.mk (𝔪 ^ 2) (X i) - s (φ (X i)) := by
    intro i; rw [hw]; exact Fin.cons_succ _ _ i
  have hwq : ∀ i : Fin n, q (w i.succ) = 0 := by
    intro i
    rw [hwsucc, map_sub, hqmk, hqs, sub_self]
  have hspan : Submodule.span κ (Set.range w) = ⊤ := by
    have h1 : (1 : A) ∈ Submodule.span κ (Set.range w) :=
      hw0 ▸ Submodule.subset_span (Set.mem_range_self 0)
    have hMM : Submodule.span κ (Set.range w) * Submodule.span κ (Set.range w)
        ≤ Submodule.span κ (Set.range w) := by
      rw [Submodule.span_mul_span]
      refine Submodule.span_le.2 ?_
      rintro z ⟨x, ⟨i, rfl⟩, y, ⟨j, rfl⟩, rfl⟩
      rcases Fin.eq_zero_or_eq_succ i with rfl | ⟨i', rfl⟩
      · change w 0 * w j ∈ _
        rw [hw0, one_mul]
        exact Submodule.subset_span (Set.mem_range_self j)
      · rcases Fin.eq_zero_or_eq_succ j with rfl | ⟨j', rfl⟩
        · change w i'.succ * w 0 ∈ _
          rw [hw0, mul_one]
          exact Submodule.subset_span (Set.mem_range_self i'.succ)
        · change w i'.succ * w j'.succ ∈ _
          rw [hmulzero _ _ (hwq i') (hwq j')]
          exact zero_mem _
    have hmulmem : ∀ x y : A, x ∈ Submodule.span κ (Set.range w) →
        y ∈ Submodule.span κ (Set.range w) → x * y ∈ Submodule.span κ (Set.range w) :=
      fun x y hx hy => hMM (Submodule.mul_mem_mul hx hy)
    set B : Subalgebra κ A := (Submodule.span κ (Set.range w)).toSubalgebra h1 hmulmem with hB
    have hXmem : ∀ i : Fin n, Ideal.Quotient.mk (𝔪 ^ 2) (X i) ∈ B := by
      intro i
      have h2 : Ideal.Quotient.mk (𝔪 ^ 2) (X i) = algebraMap κ A (φ (X i)) + w i.succ := by
        rw [hwsucc, halg]; ring
      rw [h2]
      exact add_mem (B.algebraMap_mem _) (Submodule.subset_span (Set.mem_range_self i.succ))
    have hBall : ∀ x : A, x ∈ B := by
      intro x
      obtain ⟨g, rfl⟩ := Ideal.Quotient.mk_surjective x
      induction g using MvPolynomial.induction_on with
      | C x =>
          have h2 : Ideal.Quotient.mk (𝔪 ^ 2) (C x : MvPolynomial (Fin n) k)
              = algebraMap κ A (algebraMap k κ x) := by
            rw [← IsScalarTower.algebraMap_apply k κ A, ← MvPolynomial.algebraMap_eq]
            exact (Ideal.Quotient.mkₐ k (𝔪 ^ 2)).commutes x
          rw [h2]
          exact B.algebraMap_mem _
      | add p r hp hr => rw [map_add]; exact add_mem hp hr
      | mul_X p i hp => rw [map_mul]; exact mul_mem hp (hXmem i)
    exact eq_top_iff.2 fun x _ => hBall x
  have hfinκ : Module.Finite κ A := by
    rw [Module.finite_def]
    refine ⟨Finset.univ.image w, ?_⟩
    rw [Finset.coe_image, Finset.coe_univ, Set.image_univ]
    exact hspan
  have hfink : Module.Finite k A := Module.Finite.trans κ A
  have hle : Module.finrank κ A ≤ n + 1 := by
    have hsurj : Function.Surjective (Fintype.linearCombination κ w) := by
      rw [← LinearMap.range_eq_top, Fintype.range_linearCombination, hspan]
    calc Module.finrank κ A ≤ Module.finrank κ (Fin (n + 1) → κ) :=
          LinearMap.finrank_le_finrank_of_surjective hsurj
      _ = n + 1 := by simp
  refine ⟨hfink, ?_⟩
  calc Module.finrank k A = Module.finrank k κ * Module.finrank κ A :=
        (Module.finrank_mul_finrank k κ A).symm
    _ ≤ Module.finrank k κ * (n + 1) := Nat.mul_le_mul_left _ hle
    _ = (n + 1) * Module.finrank k κ := Nat.mul_comm _ _

/-- The dimension of the target of the jet map. -/
theorem finrank_prod_pi [Module.Finite k κ] :
    Module.finrank k (κ × (Fin n → κ)) = (n + 1) * Module.finrank k κ := by
  rw [Module.finrank_prod, Module.finrank_pi_fintype]
  simp [Nat.succ_mul, Nat.add_comm]

/-- **The kernel of the jet map is `𝔪²`.** One inclusion is the Leibniz rule; for the other, the
jet map induces a surjection of `A_P = S/𝔪²` onto `κ × κⁿ`, and the two have the same finite
dimension over `k` — at most `(n+1)[κ:k]` by `finite_and_finrank_quotient_sq_le`, and exactly that
much for the target — so the surjection is injective. -/
theorem ker_jetMap [Module.Finite k κ] [Algebra.IsSeparable k κ]
    {𝔪 : Ideal (MvPolynomial (Fin n) k)} (φ : MvPolynomial (Fin n) k →ₐ[k] κ)
    (hφ : Function.Surjective φ) (hker : RingHom.ker (φ : MvPolynomial (Fin n) k →+* κ) = 𝔪) :
    LinearMap.ker (jetMap φ) = (𝔪 ^ 2).restrictScalars k := by
  obtain ⟨hfin, hlebound⟩ := finite_and_finrank_quotient_sq_le φ hφ hker
  have hsurj := surjective_jetMap φ hφ
  set p : Submodule k (MvPolynomial (Fin n) k) := (𝔪 ^ 2).restrictScalars k with hp
  have hpk : p ≤ LinearMap.ker (jetMap φ) := fun x hx =>
    jetMap_eq_zero_of_mem_sq φ hker (by simpa [hp] using hx)
  have hequivp : (MvPolynomial (Fin n) k ⧸ p) ≃ₗ[k] MvPolynomial (Fin n) k ⧸ 𝔪 ^ 2 :=
    Submodule.Quotient.restrictScalarsEquiv k (𝔪 ^ 2)
  have : Module.Finite k (MvPolynomial (Fin n) k ⧸ p) := Module.Finite.equiv hequivp.symm
  have hdimp : Module.finrank k (MvPolynomial (Fin n) k ⧸ p)
      ≤ (n + 1) * Module.finrank k κ := hequivp.finrank_eq.trans_le hlebound
  have hequivk : (MvPolynomial (Fin n) k ⧸ LinearMap.ker (jetMap φ)) ≃ₗ[k] κ × (Fin n → κ) :=
    LinearMap.quotKerEquivOfSurjective _ hsurj
  have : Module.Finite k (κ × (Fin n → κ)) := by
    have : Module.Finite k (Fin n → κ) := Module.Finite.pi
    exact Module.Finite.prod
  have : Module.Finite k (MvPolynomial (Fin n) k ⧸ LinearMap.ker (jetMap φ)) :=
    Module.Finite.equiv hequivk.symm
  have hdimk : Module.finrank k (MvPolynomial (Fin n) k ⧸ LinearMap.ker (jetMap φ))
      = (n + 1) * Module.finrank k κ := hequivk.finrank_eq.trans finrank_prod_pi
  set L : (MvPolynomial (Fin n) k ⧸ p) →ₗ[k]
      MvPolynomial (Fin n) k ⧸ LinearMap.ker (jetMap φ) :=
    p.mapQ _ LinearMap.id (by simpa using hpk) with hL
  have hLsurj : Function.Surjective L := by
    intro y
    obtain ⟨x, rfl⟩ := (LinearMap.ker (jetMap φ)).mkQ_surjective y
    exact ⟨p.mkQ x, by rw [hL]; exact p.mapQ_apply _ _ x⟩
  have hdimeq : Module.finrank k (MvPolynomial (Fin n) k ⧸ p)
      = Module.finrank k (MvPolynomial (Fin n) k ⧸ LinearMap.ker (jetMap φ)) := by
    have := LinearMap.finrank_le_finrank_of_surjective hLsurj
    omega
  have hLinj : Function.Injective L :=
    (LinearMap.injective_iff_surjective_of_finrank_eq_finrank hdimeq).2 hLsurj
  refine le_antisymm (fun x hx => ?_) hpk
  have h1 : L (p.mkQ x) = 0 := by
    have h0 : L (p.mkQ x) = (LinearMap.ker (jetMap φ)).mkQ x := p.mapQ_apply _ _ x
    rw [h0, Submodule.mkQ_apply]
    exact (Submodule.Quotient.mk_eq_zero _).2 hx
  have h2 : p.mkQ x = 0 := hLinj (by rw [h1, map_zero])
  simpa using h2

/-- **Vanishing in the first-order algebra**, in the abstract form: `g ∈ 𝔪²` exactly when `g` and
its `n` first derivatives vanish at the point. -/
theorem mem_sq_iff_forall_pderiv_eq_zero [Module.Finite k κ] [Algebra.IsSeparable k κ]
    {𝔪 : Ideal (MvPolynomial (Fin n) k)} (φ : MvPolynomial (Fin n) k →ₐ[k] κ)
    (hφ : Function.Surjective φ) (hker : RingHom.ker (φ : MvPolynomial (Fin n) k →+* κ) = 𝔪)
    (g : MvPolynomial (Fin n) k) :
    g ∈ 𝔪 ^ 2 ↔ φ g = 0 ∧ ∀ i, φ (pderiv i g) = 0 := by
  rw [← Submodule.restrictScalars_mem k, ← ker_jetMap φ hφ hker, LinearMap.mem_ker, jetMap_apply]
  refine ⟨fun h => ⟨congrArg Prod.fst h, fun i => congrFun (congrArg Prod.snd h) i⟩, ?_⟩
  rintro ⟨h1, h2⟩
  exact Prod.ext_iff.2 ⟨h1, funext h2⟩

/-- **The dimension of the first-order algebra**, in the abstract form. -/
theorem finrank_quotient_sq [Module.Finite k κ] [Algebra.IsSeparable k κ]
    {𝔪 : Ideal (MvPolynomial (Fin n) k)} (φ : MvPolynomial (Fin n) k →ₐ[k] κ)
    (hφ : Function.Surjective φ) (hker : RingHom.ker (φ : MvPolynomial (Fin n) k →+* κ) = 𝔪) :
    Module.finrank k (MvPolynomial (Fin n) k ⧸ 𝔪 ^ 2) = (n + 1) * Module.finrank k κ := by
  have hequivp : (MvPolynomial (Fin n) k ⧸ (𝔪 ^ 2).restrictScalars k) ≃ₗ[k]
      MvPolynomial (Fin n) k ⧸ 𝔪 ^ 2 := Submodule.Quotient.restrictScalarsEquiv k (𝔪 ^ 2)
  have hequivk : (MvPolynomial (Fin n) k ⧸ LinearMap.ker (jetMap φ)) ≃ₗ[k] κ × (Fin n → κ) :=
    LinearMap.quotKerEquivOfSurjective _ (surjective_jetMap φ hφ)
  rw [← hequivp.finrank_eq, ← ker_jetMap φ hφ hker, hequivk.finrank_eq, finrank_prod_pi]

end Jet

/-! ## The first-order algebra at a closed point of `𝔸ⁿ` over a perfect field -/

section ClosedPoint

variable {k : Type*} [Field k] {n : ℕ}

/-- The residue field at a closed point of `𝔸ⁿ_k` is finite dimensional over `k`: it is a field of
finite type over `k`, hence integral over `k` because a polynomial ring over a field is a Jacobson
ring. -/
theorem module_finite_residueFieldAt (P : MaximalSpectrum (MvPolynomial (Fin n) k)) :
    Module.Finite k (residueFieldAt P) := by
  have : P.asIdeal.IsMaximal := P.isMaximal
  have : Algebra.IsIntegral k (residueFieldAt P) :=
    ⟨fun x => MvPolynomial.quotient_mk_comp_C_isIntegral_of_isJacobsonRing P.asIdeal x⟩
  have : Algebra.FiniteType k (MvPolynomial (Fin n) k) := inferInstance
  have : Algebra.FiniteType k (residueFieldAt P) := Algebra.FiniteType.quotient k P.asIdeal
  exact Algebra.IsIntegral.finite

/-- The residue field at a closed point of `𝔸ⁿ_k` is separable over `k` when `k` is perfect. -/
theorem isSeparable_residueFieldAt [PerfectField k]
    (P : MaximalSpectrum (MvPolynomial (Fin n) k)) :
    Algebra.IsSeparable k (residueFieldAt P) := by
  have : P.asIdeal.IsMaximal := P.isMaximal
  let : Field (residueFieldAt P) := Ideal.Quotient.field _
  have := module_finite_residueFieldAt P
  infer_instance

/-- **The dimension of the first-order algebra.** At a closed point `P` of `𝔸ⁿ` over a perfect
field, `dim_k A_P = (n+1) deg P`. -/
@[browning_sawin "lem_jet_dimension"]
theorem finrank_jetAlgebra [PerfectField k] (P : MaximalSpectrum (MvPolynomial (Fin n) k)) :
    Module.finrank k (jetAlgebra P) = (n + 1) * pointDegree k P := by
  have : P.asIdeal.IsMaximal := P.isMaximal
  let : Field (residueFieldAt P) := Ideal.Quotient.field _
  have := module_finite_residueFieldAt P
  have := isSeparable_residueFieldAt P
  rw [pointDegree]
  exact finrank_quotient_sq (Ideal.Quotient.mkₐ k P.asIdeal) Ideal.Quotient.mk_surjective
    Ideal.mk_ker

/-- **Vanishing in the first-order algebra.** The image of `g` in `A_P = S/𝔪_P²` is zero exactly
when `g` and all its first derivatives vanish at `P`. -/
@[browning_sawin "lem_jet_vanishing"]
theorem mk_sq_eq_zero_iff [PerfectField k] (P : MaximalSpectrum (MvPolynomial (Fin n) k))
    (g : MvPolynomial (Fin n) k) :
    Ideal.Quotient.mk (P.asIdeal ^ 2) g = 0 ↔
      evalAt P g = 0 ∧ ∀ i, evalAt P (pderiv i g) = 0 := by
  have : P.asIdeal.IsMaximal := P.isMaximal
  let : Field (residueFieldAt P) := Ideal.Quotient.field _
  have := module_finite_residueFieldAt P
  have := isSeparable_residueFieldAt P
  rw [Ideal.Quotient.eq_zero_iff_mem]
  exact mem_sq_iff_forall_pderiv_eq_zero (Ideal.Quotient.mkₐ k P.asIdeal)
    Ideal.Quotient.mk_surjective Ideal.mk_ker g

/-- The first-order algebra at a closed point of `𝔸ⁿ` over a perfect field is finite dimensional
over the base field. -/
theorem module_finite_jetAlgebra [PerfectField k] (P : MaximalSpectrum (MvPolynomial (Fin n) k)) :
    Module.Finite k (jetAlgebra P) := by
  have : P.asIdeal.IsMaximal := P.isMaximal
  let : Field (residueFieldAt P) := Ideal.Quotient.field _
  have := module_finite_residueFieldAt P
  have := isSeparable_residueFieldAt P
  exact (finite_and_finrank_quotient_sq_le (Ideal.Quotient.mkₐ k P.asIdeal)
    Ideal.Quotient.mk_surjective Ideal.mk_ker).1

/-- The first-order algebra at a closed point is nonzero: `𝔪_P²` is contained in the proper ideal
`𝔪_P`. -/
theorem nontrivial_jetAlgebra {R : Type*} [CommRing R] (P : MaximalSpectrum R) :
    Nontrivial (jetAlgebra P) := by
  refine Submodule.Quotient.nontrivial_iff.mpr fun h => P.isMaximal.ne_top ?_
  exact top_le_iff.1 (le_trans (le_of_eq h.symm) (Ideal.pow_le_self (by norm_num)))

/-- The images of the variables generate a quotient of a polynomial ring as an algebra. -/
theorem adjoin_range_mk_X (I : Ideal (MvPolynomial (Fin n) k)) :
    Algebra.adjoin k (Set.range fun i => Ideal.Quotient.mk I (X i)) = ⊤ := by
  refine Algebra.eq_top_iff.2 fun x => ?_
  obtain ⟨g, rfl⟩ := Ideal.Quotient.mk_surjective x
  induction g using MvPolynomial.induction_on with
  | C a =>
      have h : Ideal.Quotient.mk I (C a : MvPolynomial (Fin n) k) = algebraMap k _ a := by
        rw [← MvPolynomial.algebraMap_eq]
        exact (Ideal.Quotient.mkₐ k I).commutes a
      rw [h]
      exact Subalgebra.algebraMap_mem _ a
  | add g₁ g₂ h₁ h₂ => rw [map_add]; exact add_mem h₁ h₂
  | mul_X g i hg => rw [map_mul]; exact mul_mem hg (Algebra.subset_adjoin ⟨i, rfl⟩)

/-- The image of a monomial in a quotient of a polynomial ring is the corresponding product of the
images of the variables. -/
theorem mk_monomial_eq_prod (I : Ideal (MvPolynomial (Fin n) k)) (α : Fin n →₀ ℕ) :
    Ideal.Quotient.mk I (monomial α 1) = ∏ i, Ideal.Quotient.mk I (X i) ^ α i := by
  rw [monomial_eq_C_mul_prod_X_pow, map_one, one_mul, map_prod]
  simp

/-- **A coordinate that does not vanish at `P` is a unit in `A_P`.** The residue map `A_P → κ(P)`
has square-zero kernel, so an element with invertible residue differs from a unit by a
nilpotent. -/
theorem isUnit_mk_of_evalAt_ne_zero {R : Type*} [CommRing R] (P : MaximalSpectrum R) {g : R}
    (hg : evalAt P g ≠ 0) : IsUnit (Ideal.Quotient.mk (P.asIdeal ^ 2) g) := by
  have : P.asIdeal.IsMaximal := P.isMaximal
  let : Field (residueFieldAt P) := Ideal.Quotient.field _
  obtain ⟨h, hh⟩ := Ideal.Quotient.mk_surjective (I := P.asIdeal) (evalAt P g)⁻¹
  have hgh : evalAt P (g * h) = 1 := by
    have hmul : evalAt P (g * h) = evalAt P g * evalAt P h :=
      map_mul (Ideal.Quotient.mk P.asIdeal) g h
    rw [hmul, show evalAt P h = (evalAt P g)⁻¹ from hh]
    exact mul_inv_cancel₀ hg
  have hmem : 1 - g * h ∈ P.asIdeal := by
    rw [← Ideal.Quotient.eq_zero_iff_mem, map_sub, map_one]
    have h2 : Ideal.Quotient.mk P.asIdeal (g * h) = 1 := hgh
    rw [h2, sub_self]
  have hnil : IsNilpotent (Ideal.Quotient.mk (P.asIdeal ^ 2) (1 - g * h)) :=
    ⟨2, by rw [← map_pow, Ideal.Quotient.eq_zero_iff_mem]; exact Ideal.pow_mem_pow hmem 2⟩
  have hone : (1 : R ⧸ P.asIdeal ^ 2) - Ideal.Quotient.mk (P.asIdeal ^ 2) (1 - g * h)
      = Ideal.Quotient.mk (P.asIdeal ^ 2) g * Ideal.Quotient.mk (P.asIdeal ^ 2) h := by
    rw [map_sub, map_one, ← map_mul]
    ring
  exact isUnit_of_mul_isUnit_left (hone ▸ hnil.isUnit_one_sub)

/-- Multiplying a linearly independent family by a unit preserves linear independence. -/
theorem linearIndependent_unit_mul {A ι : Type*} [CommRing A] [Algebra k A] (u : Aˣ) {v : ι → A}
    (hv : LinearIndependent k v) : LinearIndependent k fun j => (u : A) * v j := by
  have hker : LinearMap.ker (LinearMap.mulLeft k (u : A)) = ⊥ :=
    LinearMap.ker_eq_bot'.2 fun x hx => by
      have h : (u : A) * x = 0 := hx
      calc x = (↑u⁻¹ : A) * ((u : A) * x) := by rw [← mul_assoc, u.inv_mul, one_mul]
        _ = 0 := by rw [h, mul_zero]
  exact hv.map' (LinearMap.mulLeft k (u : A)) hker

/-- **Packing disjoint monomial bases.** At a closed point `P` of `𝔸ⁿ` over a perfect field at
which some coordinate function `y_{i₀}` does not vanish, put `L = (n+1) deg P`. For every `K ≥ 1`
with `KL ≤ d + 1` there are `K` pairwise disjoint groups of `L` monomials of total degree at most
`d`, each group having as image a basis of `A_P`: a monomial basis `B` of degree at most `L - 1`
exists by `exists_monomial_basis`, `y_{i₀}` is a unit in `A_P` by `isUnit_mk_of_evalAt_ne_zero`,
and the groups `y_{i₀}^{hL} B` for `0 ≤ h < K` are bases with `y_{i₀}`-exponents in the disjoint
ranges `[hL, (h+1)L - 1]`. -/
@[browning_sawin "lem_packing"]
theorem exists_packing_monomial_bases [PerfectField k]
    (P : MaximalSpectrum (MvPolynomial (Fin n) k)) {i₀ : Fin n} (hi₀ : evalAt P (X i₀) ≠ 0)
    {d K : ℕ} (_hK : 0 < K) (hKd : K * ((n + 1) * pointDegree k P) ≤ d + 1) :
    ∃ b : Fin K → Fin ((n + 1) * pointDegree k P) → (Fin n →₀ ℕ),
      Function.Injective (fun q : Fin K × Fin ((n + 1) * pointDegree k P) => b q.1 q.2) ∧
      (∀ h ℓ, (b h ℓ).degree ≤ d) ∧
      ∀ h, ∃ bs : Module.Basis (Fin ((n + 1) * pointDegree k P)) k (jetAlgebra P),
        ∀ ℓ, bs ℓ = Ideal.Quotient.mk (P.asIdeal ^ 2) (monomial (b h ℓ) 1) := by
  classical
  have : P.asIdeal.IsMaximal := P.isMaximal
  have := nontrivial_jetAlgebra P
  have := module_finite_jetAlgebra P
  set L := (n + 1) * pointDegree k P with hLdef
  have hrank : Module.finrank k (jetAlgebra P) = L := finrank_jetAlgebra P
  have hLpos : 0 < L := hrank ▸ Module.finrank_pos
  have : NeZero L := ⟨hLpos.ne'⟩
  set y : Fin n → jetAlgebra P := fun i => Ideal.Quotient.mk (P.asIdeal ^ 2) (X i) with hy
  obtain ⟨B, hBdeg, bs, hbs⟩ :=
    exists_monomial_basis k (y := y) (adjoin_range_mk_X (P.asIdeal ^ 2))
  have : Finite ↥B := Module.Finite.finite_basis bs
  have : Fintype ↥B := Fintype.ofFinite ↥B
  have hcard : Fintype.card ↥B = L := by rw [← Module.finrank_eq_card_basis bs, hrank]
  set eB : ↥B ≃ Fin L := Fintype.equivFinOfCardEq hcard with heB
  set t : Fin L → (Fin n →₀ ℕ) :=
    fun ℓ => Finsupp.equivFunOnFinite.symm ((eB.symm ℓ : Fin n → ℕ)) with ht
  have htapply : ∀ (ℓ : Fin L) (i : Fin n), t ℓ i = (eB.symm ℓ : Fin n → ℕ) i := fun _ _ => rfl
  have htdeg : ∀ ℓ, (t ℓ).degree ≤ L - 1 := by
    intro ℓ
    rw [Finsupp.degree_eq_sum]
    have := hBdeg _ (eB.symm ℓ).2
    rw [hrank] at this
    exact le_trans (Finset.sum_le_sum fun i _ => le_of_eq (htapply ℓ i)) this
  have htlt : ∀ ℓ, (t ℓ).degree < L := fun ℓ => lt_of_le_of_lt (htdeg ℓ) (by omega)
  have htinj : Function.Injective t := by
    intro ℓ ℓ' hℓ
    refine eB.symm.injective (Subtype.ext (funext fun i => ?_))
    rw [← htapply ℓ i, ← htapply ℓ' i, hℓ]
  have hmkmono : ∀ α : Fin n →₀ ℕ,
      Ideal.Quotient.mk (P.asIdeal ^ 2) (monomial α 1) = ∏ i, y i ^ α i :=
    fun α => mk_monomial_eq_prod (P.asIdeal ^ 2) α
  have hbst : ∀ ℓ, bs (eB.symm ℓ) = Ideal.Quotient.mk (P.asIdeal ^ 2) (monomial (t ℓ) 1) := by
    intro ℓ
    rw [hbs, hmkmono]
    exact Finset.prod_congr rfl fun i _ => by rw [htapply]
  obtain ⟨u, hu⟩ := isUnit_mk_of_evalAt_ne_zero P hi₀
  refine ⟨fun h ℓ => t ℓ + Finsupp.single i₀ (h * L), ?_, ?_, ?_⟩
  · rintro ⟨h, ℓ⟩ ⟨h', ℓ'⟩ hq
    simp only at hq
    have hi : t ℓ i₀ + h * L = t ℓ' i₀ + h' * L := by
      have := DFunLike.congr_fun hq i₀
      simpa using this
    have hdivlt : ∀ (ℓ : Fin L) (m : ℕ), (t ℓ i₀ + m * L) / L = m := by
      intro ℓ m
      rw [Nat.add_mul_div_right _ _ hLpos, Nat.div_eq_of_lt (lt_of_le_of_lt
        (Finset.single_le_sum (f := fun i => t ℓ i) (fun _ _ => Nat.zero_le _)
          (Finset.mem_univ i₀)) (by rw [← Finsupp.degree_eq_sum]; exact htlt ℓ)), zero_add]
    have hhh : (h : ℕ) = (h' : ℕ) := by
      rw [← hdivlt ℓ h, ← hdivlt ℓ' h', hi]
    have hheq : h = h' := Fin.ext hhh
    subst hheq
    have : t ℓ = t ℓ' := by
      have := hq
      rwa [hhh, add_left_inj] at this
    rw [Prod.mk.injEq]
    exact ⟨rfl, htinj this⟩
  · intro h ℓ
    have hdegadd : (t ℓ + Finsupp.single i₀ ((h : ℕ) * L)).degree
        = (t ℓ).degree + (h : ℕ) * L := by
      simp [Finsupp.degree_eq_sum, Finset.sum_add_distrib, Finsupp.single_apply,
        Finset.sum_ite_eq]
    rw [hdegadd]
    have h1 : (t ℓ).degree + (h : ℕ) * L < L + (h : ℕ) * L :=
      Nat.add_lt_add_right (htlt ℓ) _
    have h2 : L + (h : ℕ) * L ≤ K * L := by
      rw [show L + (h : ℕ) * L = ((h : ℕ) + 1) * L by ring]
      exact Nat.mul_le_mul_right L h.isLt
    exact Nat.lt_succ_iff.1 (lt_of_lt_of_le (lt_of_lt_of_le h1 h2) hKd)
  · intro h
    have hval : ∀ ℓ, Ideal.Quotient.mk (P.asIdeal ^ 2)
        (monomial (t ℓ + Finsupp.single i₀ ((h : ℕ) * L)) 1)
          = ((u ^ ((h : ℕ) * L) : (jetAlgebra P)ˣ) : jetAlgebra P) * bs (eB.symm ℓ) := by
      intro ℓ
      have hpoly : (monomial (t ℓ + Finsupp.single i₀ ((h : ℕ) * L)) (1 : k))
          = X i₀ ^ ((h : ℕ) * L) * monomial (t ℓ) 1 := by
        rw [X_pow_eq_monomial, monomial_mul_monomial, one_mul, add_comm]
      have hupow : ((u ^ ((h : ℕ) * L) : (jetAlgebra P)ˣ) : jetAlgebra P)
          = Ideal.Quotient.mk (P.asIdeal ^ 2) (X i₀) ^ ((h : ℕ) * L) := by
        rw [← hu]; simp
      rw [hpoly, map_mul, hbst ℓ, hupow, map_pow]
    have hli : LinearIndependent k fun ℓ => Ideal.Quotient.mk (P.asIdeal ^ 2)
        (monomial (t ℓ + Finsupp.single i₀ ((h : ℕ) * L)) 1) := by
      have h1 : LinearIndependent k fun ℓ : Fin L => bs (eB.symm ℓ) :=
        bs.linearIndependent.comp _ eB.symm.injective
      simpa only [hval] using linearIndependent_unit_mul (u ^ ((h : ℕ) * L)) h1
    refine ⟨basisOfLinearIndependentOfCardEqFinrank hli (by rw [Fintype.card_fin, hrank]),
      fun ℓ => ?_⟩
    rw [coe_basisOfLinearIndependentOfCardEqFinrank]

end ClosedPoint

/-! ## Vanishing in `A_P` is singularity -/

section AffineSingular

variable {k : Type u} [Field k] {n : ℕ}

/-- The point of the affine hypersurface `Z(g) ⊆ 𝔸ⁿ` cut out by a geometric point `a` at which `g`
vanishes; the hypersurface carries the scheme structure of `g`, repeated factors included. -/
noncomputable def affineHypersurfacePoint (g : MvPolynomial (Fin n) k)
    (a : Fin n → AlgebraicClosure k)
    (h : eval a (g.map (algebraMap k (AlgebraicClosure k))) = 0) :
    PrimeSpectrum (MvPolynomial (Fin n) (AlgebraicClosure k) ⧸
      Ideal.span {g.map (algebraMap k (AlgebraicClosure k))}) :=
  PrimeSpectrum.comap
    (Ideal.Quotient.lift (Ideal.span {g.map (algebraMap k (AlgebraicClosure k))}) (eval a)
      fun _ hx => (Ideal.span_singleton_le_iff_mem _).2 (RingHom.mem_ker.2 h) hx)
    ⟨⊥, Ideal.isPrime_bot⟩

/-- `Sing Z(g)`, the set of geometric points at which the affine hypersurface `g = 0` is not
smooth. This is the affine counterpart of `singularLocus`. -/
noncomputable def affineSingularLocus (g : MvPolynomial (Fin n) k) :
    Set (Fin n → AlgebraicClosure k) :=
  {a | ∃ h : eval a (g.map (algebraMap k (AlgebraicClosure k))) = 0,
    affineHypersurfacePoint g a h ∉ Algebra.smoothLocus (AlgebraicClosure k)
      (MvPolynomial (Fin n) (AlgebraicClosure k) ⧸
        Ideal.span {g.map (algebraMap k (AlgebraicClosure k))})}

/-- **The Jacobian criterion, read off the affine singular locus.** Over a perfect field a
geometric point lies in `Sing Z(g)` exactly when `g` and all its first derivatives vanish there. -/
theorem mem_affineSingularLocus_iff (hjac : AffineJacobianCriterion.{u}) [PerfectField k]
    {g : MvPolynomial (Fin n) k} (hg : g ≠ 0)
    (a : Fin n → AlgebraicClosure k) :
    a ∈ affineSingularLocus g ↔
      eval a (g.map (algebraMap k (AlgebraicClosure k))) = 0 ∧
        ∀ i, eval a ((pderiv i g).map (algebraMap k (AlgebraicClosure k))) = 0 := by
  constructor
  · rintro ⟨h, hns⟩
    exact ⟨h, (hjac hg h).1 hns⟩
  · rintro ⟨h, hd⟩
    exact ⟨h, (hjac hg h).2 hd⟩

/-- A geometric point above a closed point `P` detects vanishing in `κ(P)`: evaluation there
factors through `κ(P)` by an injection of fields. -/
theorem eval_map_eq_zero_iff_evalAt_eq_zero (P : MaximalSpectrum (MvPolynomial (Fin n) k))
    {a : Fin n → AlgebraicClosure k}
    (ha : ∀ f ∈ P.asIdeal, eval a (f.map (algebraMap k (AlgebraicClosure k))) = 0)
    (f : MvPolynomial (Fin n) k) :
    eval a (f.map (algebraMap k (AlgebraicClosure k))) = 0 ↔ evalAt P f = 0 := by
  have : P.asIdeal.IsMaximal := P.isMaximal
  let : Field (residueFieldAt P) := Ideal.Quotient.field _
  have hev : ∀ h : MvPolynomial (Fin n) k,
      eval₂ (algebraMap k (AlgebraicClosure k)) a h
        = eval a (h.map (algebraMap k (AlgebraicClosure k))) :=
    fun h => eval₂_eq_eval_map (algebraMap k (AlgebraicClosure k)) a h
  set ψ : residueFieldAt P →+* AlgebraicClosure k :=
    Ideal.Quotient.lift P.asIdeal (eval₂Hom (algebraMap k (AlgebraicClosure k)) a)
      (fun x hx => by
        have hx' := ha x hx
        rw [← hev x] at hx'
        exact hx') with hψ
  have hψmk : ∀ h, ψ (evalAt P h) = eval a (h.map (algebraMap k (AlgebraicClosure k))) := by
    intro h
    rw [← hev h]
    rfl
  rw [← hψmk f, ← map_zero ψ]
  exact ⟨fun h => ψ.injective h, fun h => congrArg ψ h⟩

/-- **Vanishing in `A_P` is singularity.** For nonzero `g`, the image of `g` in `A_P` is zero
exactly when the affine hypersurface `g = 0` is singular at a geometric point above the closed
point `P`. -/
@[browning_sawin "lem_jet_singular"]
theorem mk_sq_eq_zero_iff_mem_affineSingularLocus (hjac : AffineJacobianCriterion.{u})
    [PerfectField k]
    (P : MaximalSpectrum (MvPolynomial (Fin n) k)) {g : MvPolynomial (Fin n) k} (hg : g ≠ 0)
    {a : Fin n → AlgebraicClosure k}
    (ha : ∀ f ∈ P.asIdeal, eval a (f.map (algebraMap k (AlgebraicClosure k))) = 0) :
    Ideal.Quotient.mk (P.asIdeal ^ 2) g = 0 ↔ a ∈ affineSingularLocus g := by
  rw [mk_sq_eq_zero_iff, mem_affineSingularLocus_iff hjac hg a,
    eval_map_eq_zero_iff_evalAt_eq_zero P ha g]
  refine and_congr Iff.rfl (forall_congr' fun i => ?_)
  rw [eval_map_eq_zero_iff_evalAt_eq_zero P ha (pderiv i g)]

end AffineSingular

/-! ## The probability of singularity at a prescribed closed point -/

section LocalBound

open MeasureTheory

variable {p : ℕ} [Fact p.Prime] {n d : ℕ}

/-- The affine sign polynomial is nonzero: its constant coefficient is a sign, and `±1 ≠ 0` modulo
a prime. -/
theorem affineSignPoly_ne_zero (ε : SignFamily (monomialsLE n d)) :
    affineSignPoly p n d ε ≠ 0 := by
  classical
  have hmem : (0 : Fin n →₀ ℕ) ∈ monomialsLE n d := mem_monomialsLE.2 (by simp)
  have hcoeff : (affineSignPoly p n d ε).coeff 0 = ((signOf ε 0 : ℤ) : ZMod p) := by
    rw [affineSignPoly, coeff_sum, Finset.sum_eq_single_of_mem 0 hmem
      fun b _ hb => by simp [coeff_monomial, hb]]
    rw [coeff_monomial, ite_eq_left rfl]
  intro h
  rw [h, coeff_zero] at hcoeff
  rcases Int.units_eq_one_or (signOf ε 0) with hu | hu <;> rw [hu] at hcoeff <;>
    simp [eq_comm] at hcoeff

/-- **The probability of singularity at a prescribed closed point.** Let `P` be a closed point of
`𝔸ⁿ_{𝔽ₚ}` at which some coordinate function does not vanish, put `L = (n+1) deg P`, and let `K ≥ 1`
satisfy `KL ≤ d + 1`. Then the hypersurface `g = 0` cut out by the affine sign polynomial is
singular at `P` with probability at most `Θ_K(p)^L`.

Under an `𝔽ₚ`-linear isomorphism `A_P ≃ 𝔽ₚ^L` — available because `dim_{𝔽ₚ} A_P = L` by
`finrank_jetAlgebra` — the image of `g` in `A_P` is the sign sum `∑_β ε_β v_β` of the images `v_β`
of the monomials `y^β`. Singularity at `P` is the vanishing of that image
(`mk_sq_eq_zero_iff_mem_affineSingularLocus`, applicable because `g` is never zero),
`exists_packing_monomial_bases` supplies the `K` pairwise disjoint groups of indices `β` each of
which indexes a basis of `𝔽ₚ^L`, and the Fourier–Hölder bound
`signMeasure_sign_sum_le_theta_pow` finishes. -/
@[browning_sawin "prop_local"]
theorem signMeasure_mem_affineSingularLocus_affineSignPoly_le
    (hjac : AffineJacobianCriterion.{0})
    (P : MaximalSpectrum (MvPolynomial (Fin n) (ZMod p))) {i₀ : Fin n}
    (hi₀ : evalAt P (X i₀) ≠ 0) {K : ℕ} (hK : 0 < K)
    (hKd : K * ((n + 1) * pointDegree (ZMod p) P) ≤ d + 1)
    {a : Fin n → AlgebraicClosure (ZMod p)}
    (ha : ∀ f ∈ P.asIdeal,
      eval a (f.map (algebraMap (ZMod p) (AlgebraicClosure (ZMod p)))) = 0) :
    signMeasure ↥(monomialsLE n d) {ε | a ∈ affineSingularLocus (affineSignPoly p n d ε)}
      ≤ ENNReal.ofReal (theta p K ^ ((n + 1) * pointDegree (ZMod p) P)) := by
  classical
  have : P.asIdeal.IsMaximal := P.isMaximal
  have := nontrivial_jetAlgebra P
  have := module_finite_jetAlgebra (k := ZMod p) P
  set L := (n + 1) * pointDegree (ZMod p) P with hLdef
  have hrank : Module.finrank (ZMod p) (jetAlgebra P) = L := finrank_jetAlgebra P
  set φ : jetAlgebra P ≃ₗ[ZMod p] (Fin L → ZMod p) :=
    LinearEquiv.ofFinrankEq _ _ (by rw [hrank, Module.finrank_fin_fun]) with hφ
  set v : ↥(monomialsLE n d) → Fin L → ZMod p :=
    fun j => φ (Ideal.Quotient.mk (P.asIdeal ^ 2) (monomial (j : Fin n →₀ ℕ) 1)) with hv
  have hsum : ∀ ε : SignFamily (monomialsLE n d),
      φ (Ideal.Quotient.mk (P.asIdeal ^ 2) (affineSignPoly p n d ε)) = ∑ j, (ε j : ℤ) • v j := by
    intro ε
    have h1 : φ (Ideal.Quotient.mk (P.asIdeal ^ 2) (affineSignPoly p n d ε))
        = ∑ β ∈ monomialsLE n d, (signOf ε β : ℤ) •
            φ (Ideal.Quotient.mk (P.asIdeal ^ 2) (monomial β 1)) := by
      rw [affineSignPoly, map_sum, map_sum]
      refine Finset.sum_congr rfl fun β _ => ?_
      rw [show (monomial β (((signOf ε β : ℤ) : ZMod p)) : MvPolynomial (Fin n) (ZMod p))
            = (signOf ε β : ℤ) • monomial β 1 by
              rw [zsmul_eq_mul,
                ← map_intCast (C : ZMod p →+* MvPolynomial (Fin n) (ZMod p)) (signOf ε β : ℤ),
                C_mul_monomial, mul_one],
        map_zsmul, map_zsmul]
    rw [h1, ← Finset.sum_coe_sort (monomialsLE n d) fun β => (signOf ε β : ℤ) •
      φ (Ideal.Quotient.mk (P.asIdeal ^ 2) (monomial β 1))]
    exact Finset.sum_congr rfl fun j _ => by rw [signOf_of_mem ε j.2]
  have hevent : {ε : SignFamily (monomialsLE n d) |
        a ∈ affineSingularLocus (affineSignPoly p n d ε)} = {ε | ∑ j, (ε j : ℤ) • v j = 0} := by
    ext ε
    simp only [Set.mem_ofPred_eq]
    rw [← mk_sq_eq_zero_iff_mem_affineSingularLocus hjac P (affineSignPoly_ne_zero ε) ha, ← hsum ε]
    exact ⟨fun h => by rw [h, map_zero], fun h => φ.injective (by rw [h, map_zero])⟩
  rw [hevent]
  obtain ⟨bp, hbinj, hbdeg, hbbasis⟩ := exists_packing_monomial_bases P hi₀ hK hKd
  refine signMeasure_sign_sum_le_theta_pow hK (v := v)
    (b := fun h ℓ => (⟨bp h ℓ, mem_monomialsLE.2 (hbdeg h ℓ)⟩ : ↥(monomialsLE n d)))
    (fun q q' hq => hbinj (Subtype.ext_iff.1 hq)) (fun h => ?_) 0
  obtain ⟨bs, hbs⟩ := hbbasis h
  have h1 : LinearIndependent (ZMod p) fun ℓ =>
      Ideal.Quotient.mk (P.asIdeal ^ 2) (monomial (bp h ℓ) 1) := by
    have h0 := bs.linearIndependent
    rwa [funext hbs] at h0
  exact h1.map' (φ : jetAlgebra P →ₗ[ZMod p] (Fin L → ZMod p))
    (LinearMap.ker_eq_bot_of_injective φ.injective)

end LocalBound

/-! ## Counting closed points by degree

A closed point of `ℙⁿ_{𝔽ₚ}` of degree `e` is an orbit of length `e` of the `p`-power map on
`ℙⁿ(𝔽̄ₚ)`, so it contributes `e` distinct points fixed by the `p^e`-power map, and distinct closed
points contribute disjoint sets of them. The points fixed by the `p^e`-power map are the
`𝔽_{p^e}`-rational ones, of which there are `1 + p^e + ⋯ + p^{ne}`. -/

section PointCount

open Polynomial

/-! ### The power map on points -/

/-- Raising every coordinate of a nonzero vector to the `q`-th power, `q ≠ 0`, again gives a
nonzero vector. -/
theorem pow_ne_zero_of_ne_zero {q : ℕ} [NeZero q] {K : Type*} [Field K] {m : ℕ}
    {v : Fin (m + 1) → K} (hv : v ≠ 0) : (fun i => v i ^ q) ≠ 0 := fun h =>
  hv (funext fun i => by
    have := congrFun h i
    simpa [pow_eq_zero_iff (NeZero.ne q)] using this)

/-- The `q`-power map is computed on the distinguished representative of a projective point. -/
theorem projPowMap_eq_mk {q : ℕ} [NeZero q] {K : Type*} [Field K] {m : ℕ}
    (P : Projectivization K (Fin (m + 1) → K)) (h : (fun i => P.rep i ^ q) ≠ 0) :
    projPowMap q P = Projectivization.mk K (fun i => P.rep i ^ q) h := rfl

/-- The `q`-power map raises the coordinates of *any* representative to the `q`-th power, not only
those of the distinguished one. -/
theorem projPowMap_mk {q : ℕ} [NeZero q] {K : Type*} [Field K] {m : ℕ}
    {v : Fin (m + 1) → K} (hv : v ≠ 0) (hvq : (fun i => v i ^ q) ≠ 0) :
    projPowMap q (Projectivization.mk K v hv) = Projectivization.mk K (fun i => v i ^ q) hvq := by
  obtain ⟨a, ha⟩ := Projectivization.exists_smul_eq_mk_rep K v hv
  rw [projPowMap, Projectivization.mk_eq_mk_iff]
  refine ⟨a ^ q, funext fun i => ?_⟩
  have h1 : (Projectivization.mk K v hv).rep i = (a : K) * v i := by
    rw [← ha]; simp [Units.smul_def]
  simp [h1, mul_pow, Units.smul_def]

/-- The `1`-power map is the identity. -/
@[simp]
theorem projPowMap_one {K : Type*} [Field K] {m : ℕ}
    (P : Projectivization K (Fin (m + 1) → K)) : projPowMap 1 P = P := by
  rw [projPowMap]; simp

/-- Equal exponents give the same power map. -/
theorem projPowMap_congr {q r : ℕ} [NeZero q] [NeZero r] {K : Type*} [Field K] {m : ℕ}
    (h : q = r) (P : Projectivization K (Fin (m + 1) → K)) :
    projPowMap q P = projPowMap r P := by subst h; rfl

/-- Composing the `r`-power map with the `q`-power map is the `rq`-power map. -/
theorem projPowMap_projPowMap {q r : ℕ} [NeZero q] [NeZero r] {K : Type*} [Field K] {m : ℕ}
    (P : Projectivization K (Fin (m + 1) → K)) :
    projPowMap q (projPowMap r P) = projPowMap (r * q) P := by
  have : NeZero (r * q) := ⟨by simp [NeZero.ne q, NeZero.ne r]⟩
  have hne : (fun i => P.rep i ^ r) ≠ 0 := pow_ne_zero_of_ne_zero P.rep_nonzero
  have hne2 : (fun i => (P.rep i ^ r) ^ q) ≠ 0 := pow_ne_zero_of_ne_zero hne
  rw [projPowMap_eq_mk P hne, projPowMap_mk hne hne2, projPowMap]
  simp [← pow_mul]

/-- Iterating the `q`-power map `j` times is the `q^j`-power map; for `q = p` over `𝔽̄ₚ` this says
that the `j`-th power of the Frobenius map raises the coordinates to the `p^j`-th power. -/
theorem iterate_projPowMap {q : ℕ} [NeZero q] {K : Type*} [Field K] {m : ℕ}
    (j : ℕ) (P : Projectivization K (Fin (m + 1) → K)) :
    (projPowMap q)^[j] P = projPowMap (q ^ j) P := by
  induction j with
  | zero => simp
  | succ j ih =>
      have : NeZero (q ^ j) := ⟨pow_ne_zero _ (NeZero.ne q)⟩
      rw [Function.iterate_succ_apply', ih, projPowMap_projPowMap]
      exact projPowMap_congr (pow_succ q j).symm P

/-! ### The field `𝔽_{p^e}` inside `𝔽̄ₚ` -/

/-- `𝔽_{p^e}`, realized inside `𝔽̄ₚ` as the subfield of elements fixed by the `e`-th iterate of the
Frobenius, that is the roots of `x^{p^e} = x`. -/
noncomputable def frobFixedField (p e : ℕ) [Fact p.Prime] : Subfield (AlgebraicClosure (ZMod p)) :=
  FixedBy.subfield _ (iterateFrobeniusEquiv (AlgebraicClosure (ZMod p)) p e)

/-- An element of `𝔽̄ₚ` lies in `𝔽_{p^e}` exactly when it satisfies `x^{p^e} = x`. -/
@[simp]
theorem mem_frobFixedField {p e : ℕ} [Fact p.Prime] {x : AlgebraicClosure (ZMod p)} :
    x ∈ frobFixedField p e ↔ x ^ p ^ e = x := by
  rw [frobFixedField, FixedBy.subfield_mem_iff]
  simp [RingAut.smul_def, iterateFrobeniusEquiv_apply, iterateFrobenius_def]

/-- `𝔽_{p^e}` is finite with at most `p^e` elements: its elements are roots of the polynomial
`x^{p^e} - x`, which is nonzero of degree `p^e` as soon as `e ≥ 1`. -/
theorem finite_and_card_frobFixedField_le {p e : ℕ} [Fact p.Prime] (he : 1 ≤ e) :
    (frobFixedField p e : Set (AlgebraicClosure (ZMod p))).Finite ∧
      Nat.card (frobFixedField p e) ≤ p ^ e := by
  classical
  have hp2 : 2 ≤ p := (Fact.out (p := p.Prime)).two_le
  have hq2 : 2 ≤ p ^ e := le_trans hp2 (Nat.le_self_pow (by omega) p)
  set K := AlgebraicClosure (ZMod p)
  set f : K[X] := Polynomial.X ^ p ^ e - Polynomial.X with hf
  have hdeg : f.natDegree = p ^ e := by
    rw [hf, natDegree_sub_eq_left_of_natDegree_lt]
    · simp
    · simp; omega
  have hf0 : f ≠ 0 := by
    intro h
    rw [h, natDegree_zero] at hdeg
    omega
  set s : Finset K := f.roots.toFinset with hs
  have hcard : s.card ≤ p ^ e :=
    le_trans (Multiset.toFinset_card_le _) (hdeg ▸ f.card_roots')
  have hsub : (frobFixedField p e : Set K) ⊆ ↑s := by
    intro x hx
    have hroot : f.IsRoot x := by
      rw [hf]
      simp only [IsRoot.def, Polynomial.eval_sub, Polynomial.eval_pow, Polynomial.eval_X,
        sub_eq_zero]
      exact mem_frobFixedField.1 hx
    exact Finset.mem_coe.2 (by rw [hs, Multiset.mem_toFinset, mem_roots hf0]; exact hroot)
  refine ⟨Set.Finite.subset s.finite_toSet hsub, ?_⟩
  calc Nat.card (frobFixedField p e) = (frobFixedField p e : Set K).ncard := Nat.card_coe_set_eq _
    _ ≤ (↑s : Set K).ncard := Set.ncard_le_ncard hsub s.finite_toSet
    _ = s.card := by simp
    _ ≤ p ^ e := hcard

/-! ### The rational points fixed by a power of the Frobenius -/

/-- **The points fixed by the `p^e`-power map are the `𝔽_{p^e}`-rational ones**, and there are at
most `1 + p^e + ⋯ + p^{ne}` of them: normalizing a fixed point so that some coordinate is `1`
forces every coordinate to satisfy `x^{p^e} = x`, so the point comes from `ℙⁿ(𝔽_{p^e})`, and `ℙⁿ`
over a field with at most `p^e` elements has at most that many points. -/
theorem finite_and_ncard_setOf_projPowMap_eq_le {p n e : ℕ} [Fact p.Prime] (he : 1 ≤ e) :
    {P : ProjPoint p n | projPowMap (p ^ e) P = P}.Finite ∧
      {P : ProjPoint p n | projPowMap (p ^ e) P = P}.ncard
        ≤ ∑ i ∈ Finset.range (n + 1), p ^ (i * e) := by
  classical
  obtain ⟨hfin, hcard⟩ := finite_and_card_frobFixedField_le (p := p) (e := e) he
  have : Finite (frobFixedField p e) := hfin.to_subtype
  set S := frobFixedField p e with hS
  set K := AlgebraicClosure (ZMod p)
  set ι : (Fin (n + 1) → S) →ₛₗ[S.subtype] (Fin (n + 1) → K) :=
    { toFun := fun w i => (w i : K)
      map_add' := fun w w' => by funext i; simp
      map_smul' := fun c w => by funext i; simp } with hι
  have hιinj : Function.Injective ι := fun w w' h =>
    funext fun i => Subtype.ext (congrFun h i)
  set Φ := Projectivization.map ι hιinj with hΦ
  have hrange : {P : ProjPoint p n | projPowMap (p ^ e) P = P} ⊆ Set.range Φ := by
    intro P hP
    obtain ⟨j, hj⟩ : ∃ j, P.rep j ≠ 0 := by
      by_contra hcon
      push Not at hcon
      exact P.rep_nonzero (funext hcon)
    have hne : (fun i => P.rep i ^ p ^ e) ≠ 0 := pow_ne_zero_of_ne_zero P.rep_nonzero
    have h1 : Projectivization.mk K (fun i => P.rep i ^ p ^ e) hne
        = Projectivization.mk K P.rep P.rep_nonzero := by
      rw [← projPowMap_eq_mk P hne, hP, Projectivization.mk_rep]
    obtain ⟨a, ha⟩ := (Projectivization.mk_eq_mk_iff K _ _ hne P.rep_nonzero).1 h1
    have ha0 : (a : K) ≠ 0 := a.ne_zero
    have hcoord : ∀ i, P.rep i ^ p ^ e = (a : K) * P.rep i := fun i => by
      rw [← congrFun ha i]; simp [Units.smul_def]
    have hmem : ∀ i, (P.rep j)⁻¹ * P.rep i ∈ S := by
      intro i
      rw [hS, mem_frobFixedField]
      calc ((P.rep j)⁻¹ * P.rep i) ^ p ^ e = (P.rep j ^ p ^ e)⁻¹ * P.rep i ^ p ^ e := by
            rw [mul_pow, inv_pow]
        _ = ((a : K) * P.rep j)⁻¹ * ((a : K) * P.rep i) := by rw [hcoord i, hcoord j]
        _ = (P.rep j)⁻¹ * P.rep i := by
              rw [mul_inv, mul_mul_mul_comm, inv_mul_cancel₀ ha0, one_mul]
    set w : Fin (n + 1) → S := fun i => ⟨(P.rep j)⁻¹ * P.rep i, hmem i⟩ with hw
    have hwj : w j = 1 := Subtype.ext (by simpa [hw] using inv_mul_cancel₀ hj)
    have hw0 : w ≠ 0 := fun h => one_ne_zero (hwj ▸ congrFun h j)
    refine ⟨Projectivization.mk S w hw0, ?_⟩
    rw [hΦ, Projectivization.map_mk, ← Projectivization.mk_rep P]
    refine (Projectivization.mk_eq_mk_iff K _ _ _ _).2
      ⟨Units.mk0 ((P.rep j)⁻¹) (inv_ne_zero hj), funext fun i => ?_⟩
    change (P.rep j)⁻¹ • P.rep i = ((w i : K))
    simp [hw]
  refine ⟨Set.Finite.subset (Set.finite_range Φ) hrange, ?_⟩
  calc {P : ProjPoint p n | projPowMap (p ^ e) P = P}.ncard
      ≤ (Set.range Φ).ncard := Set.ncard_le_ncard hrange (Set.finite_range Φ)
    _ = (Φ '' Set.univ).ncard := by rw [Set.image_univ]
    _ ≤ (Set.univ : Set (Projectivization S (Fin (n + 1) → S))).ncard :=
        Set.ncard_image_le Set.finite_univ
    _ = Nat.card (Projectivization S (Fin (n + 1) → S)) := Set.ncard_univ _
    _ = ∑ i ∈ Finset.range (n + 1), Nat.card S ^ i :=
        Projectivization.card_of_finrank _ _ (Module.finrank_fin_fun _)
    _ ≤ ∑ i ∈ Finset.range (n + 1), p ^ (i * e) := Finset.sum_le_sum fun i _ => by
        rw [pow_mul']; exact Nat.pow_le_pow_left hcard i

/-! ### Each closed point of degree `e` contributes `e` fixed points -/

/-- **The closed points of degree `e` contribute `e C_e` distinct fixed points.** A closed point of
degree `e` is a Frobenius orbit of length `e`, its `e` members are fixed by the `p^e`-power map,
and distinct closed points are disjoint orbits. -/
theorem mul_closedPointCount_le_ncard {p n e : ℕ} [Fact p.Prime] (he : 1 ≤ e) :
    e * closedPointCount p n e ≤ {P : ProjPoint p n | projPowMap (p ^ e) P = P}.ncard := by
  classical
  have : NeZero p := ⟨(Fact.out (p := p.Prime)).ne_zero⟩
  obtain ⟨hFixfin, -⟩ := finite_and_ncard_setOf_projPowMap_eq_le (p := p) (n := n) (e := e) he
  have : Finite ↥{P : ProjPoint p n | projPowMap (p ^ e) P = P} := hFixfin.to_subtype
  set C := {c : Cycle (ProjPoint p n) // ∃ P : ProjPoint p n,
      Function.minimalPeriod (projPowMap p) P = e ∧
        c = Function.periodicOrbit (projPowMap p) P} with hC
  have hCcard : closedPointCount p n e = Nat.card C := rfl
  have hper : ∀ c : C, Function.minimalPeriod (projPowMap p) c.2.choose = e := fun c =>
    c.2.choose_spec.1
  have hcyc : ∀ c : C, (c : Cycle (ProjPoint p n))
      = Function.periodicOrbit (projPowMap p) c.2.choose := fun c => c.2.choose_spec.2
  have hfix : ∀ c : C, Function.IsPeriodicPt (projPowMap p) e c.2.choose := by
    intro c
    have h := Function.isPeriodicPt_minimalPeriod (projPowMap p) c.2.choose
    rwa [hper c] at h
  have hmemper : ∀ c : C, c.2.choose ∈ Function.periodicPts (projPowMap p) := fun c =>
    Function.mem_periodicPts.2 ⟨e, by omega, hfix c⟩
  refine le_trans (le_of_eq ?_)
    (Nat.card_le_card_of_injective
      (β := ↥{P : ProjPoint p n | projPowMap (p ^ e) P = P})
      (fun x : C × Fin e => ⟨(projPowMap p)^[(x.2 : ℕ)] x.1.2.choose, ?_⟩) ?_)
  · rw [hCcard, Nat.card_prod, Nat.card_eq_fintype_card (α := Fin e), Fintype.card_fin,
      Nat.mul_comm]
  · change projPowMap (p ^ e) ((projPowMap p)^[(x.2 : ℕ)] x.1.2.choose)
      = (projPowMap p)^[(x.2 : ℕ)] x.1.2.choose
    rw [← iterate_projPowMap, ← Function.iterate_add_apply,
      Nat.add_comm e (x.2 : ℕ), Function.iterate_add_apply]
    exact congrArg _ (hfix x.1)
  · rintro ⟨c, i⟩ ⟨c', i'⟩ hxy
    have hxy' : (projPowMap p)^[(i : ℕ)] c.2.choose = (projPowMap p)^[(i' : ℕ)] c'.2.choose :=
      congrArg Subtype.val hxy
    have hcc : c = c' := by
      refine Subtype.ext ?_
      rw [hcyc c, hcyc c', ← Function.periodicOrbit_apply_iterate_eq (hmemper c) (i : ℕ),
        ← Function.periodicOrbit_apply_iterate_eq (hmemper c') (i' : ℕ), hxy']
    subst hcc
    have hii : (i : ℕ) = (i' : ℕ) :=
      Function.iterate_injOn_Iio_minimalPeriod
        (Set.mem_Iio.2 (by rw [hper c]; exact i.isLt))
        (Set.mem_Iio.2 (by rw [hper c]; exact i'.isLt)) hxy'
    exact Prod.ext rfl (Fin.ext hii)

/-! ### The two inequalities -/

/-- A geometric sum is bounded by its largest term times `c`, as soon as `c ≤ x(c-1)`. -/
theorem sum_pow_le_mul_pow {x c : ℝ} (hx : 0 ≤ x) (hc : 1 ≤ c) (hcx : c ≤ x * (c - 1)) (n : ℕ) :
    ∑ i ∈ Finset.range (n + 1), x ^ i ≤ c * x ^ n := by
  induction n with
  | zero => simpa using hc
  | succ n ih =>
      rw [Finset.sum_range_succ]
      have h1 : x ^ n * c ≤ x ^ n * (x * (c - 1)) :=
        mul_le_mul_of_nonneg_left hcx (pow_nonneg hx n)
      have h2 : x ^ (n + 1) = x ^ n * x := pow_succ x n
      nlinarith [pow_nonneg hx n]

/-- **Counting closed points by degree, first inequality.** The `C_e` closed points of degree `e`
of `ℙⁿ_{𝔽ₚ}` contribute `e C_e` distinct `𝔽_{p^e}`-points of `ℙⁿ`, so
`e C_e ≤ #ℙⁿ(𝔽_{p^e}) = 1 + p^e + ⋯ + p^{ne}`. -/
@[browning_sawin "lem_point_count"]
theorem mul_closedPointCount_le_sum_pow (p n e : ℕ) [Fact p.Prime] (he : 1 ≤ e) :
    e * closedPointCount p n e ≤ ∑ i ∈ Finset.range (n + 1), p ^ (i * e) :=
  le_trans (mul_closedPointCount_le_ncard he)
    (finite_and_ncard_setOf_projPowMap_eq_le he).2

/-- **Counting closed points by degree, second inequality.** Factoring out the largest term,
`1 + p^e + ⋯ + p^{ne} = p^{ne}(1 + p^{-e} + ⋯ + p^{-ne})` and
`∑_{j ≥ 0} p^{-je} = (1 - p^{-e})^{-1} ≤ (1 - p^{-1})^{-1} = p/(p-1)` because `e ≥ 1`. -/
@[browning_sawin "lem_point_count"]
theorem sum_pow_le_div_mul_pow {p : ℕ} (hp : 2 ≤ p) (n : ℕ) {e : ℕ} (he : 1 ≤ e) :
    (∑ i ∈ Finset.range (n + 1), (p : ℝ) ^ (i * e))
      ≤ (p : ℝ) / (p - 1) * (p : ℝ) ^ (n * e) := by
  have hp1 : (1 : ℝ) < p := by exact_mod_cast hp
  set x := (p : ℝ) ^ e with hxdef
  set c := (p : ℝ) / (p - 1) with hcdef
  have hx0 : (0 : ℝ) ≤ x := by positivity
  have hp10 : (p : ℝ) - 1 ≠ 0 := by intro h; rw [sub_eq_zero] at h; linarith
  have hpx : (p : ℝ) ≤ x := by
    have h : (p : ℝ) ^ 1 ≤ (p : ℝ) ^ e := pow_le_pow_right₀ hp1.le he
    simpa [hxdef] using h
  have hc1 : 1 ≤ c := by
    rw [hcdef, le_div_iff₀ (by linarith)]
    linarith
  have hcsub : c - 1 = 1 / ((p : ℝ) - 1) := by
    rw [hcdef, div_sub_one hp10]
    congr 1
    ring
  have hcx : c ≤ x * (c - 1) := by
    rw [hcsub, mul_one_div, le_div_iff₀ (by linarith), hcdef, div_mul_eq_mul_div,
      div_le_iff₀ (by linarith)]
    nlinarith
  calc ∑ i ∈ Finset.range (n + 1), (p : ℝ) ^ (i * e)
      = ∑ i ∈ Finset.range (n + 1), x ^ i :=
        Finset.sum_congr rfl fun i _ => by rw [hxdef, ← pow_mul, Nat.mul_comm]
    _ ≤ c * x ^ n := sum_pow_le_mul_pow hx0 hc1 hcx n
    _ = (p : ℝ) / (p - 1) * (p : ℝ) ^ (n * e) := by rw [hxdef, ← pow_mul, Nat.mul_comm]

/-- The form in which the count enters the union bound: `C_e ≤ (p/(p-1)) p^{ne}/e`. -/
theorem closedPointCount_le_div {p : ℕ} [Fact p.Prime] (n : ℕ) {e : ℕ} (he : 1 ≤ e) :
    (closedPointCount p n e : ℝ) ≤ (p : ℝ) / (p - 1) * (p : ℝ) ^ (n * e) / e := by
  have hp2 : 2 ≤ p := (Fact.out (p := p.Prime)).two_le
  have he0 : (0 : ℝ) < e := by positivity
  rw [le_div_iff₀ he0]
  have h1 : ((e * closedPointCount p n e : ℕ) : ℝ)
      ≤ ((∑ i ∈ Finset.range (n + 1), p ^ (i * e) : ℕ) : ℝ) := by
    exact_mod_cast mul_closedPointCount_le_sum_pow p n e he
  push_cast at h1
  calc (closedPointCount p n e : ℝ) * e = (e : ℝ) * closedPointCount p n e := by ring
    _ ≤ ∑ i ∈ Finset.range (n + 1), (p : ℝ) ^ (i * e) := h1
    _ ≤ (p : ℝ) / (p - 1) * (p : ℝ) ^ (n * e) := sum_pow_le_div_mul_pow hp2 n he

end PointCount

/-! ## Closed points of small degree

A closed point of `ℙⁿ_{𝔽ₚ}` of degree `e` is an orbit of length `e` of the `p`-power map, and one
geometric point of it is singled out. It is not a coordinate vertex, because no coordinate vertex
lies on `X_{f̄}`, so it has two nonzero homogeneous coordinates; normalizing one of them to `1` and
deleting it presents the point on a standard affine chart, where it becomes a closed point of
`𝔸ⁿ_{𝔽ₚ}` of the *same* degree `e` — dehomogenization does not change the residue field — which is
not the origin. There `f̄` becomes the affine sign polynomial, and the local bound applies with
`K = K_e`. -/

section LowDegree

open MeasureTheory

variable {p : ℕ} [Fact p.Prime] {n d : ℕ}

/-! ### Homogeneity, and nonvanishing of the reduced random sign form -/

/-- The cosine average `Θ_K(p)` is nonnegative. -/
private theorem theta_nonneg (p K : ℕ) [NeZero p] : 0 ≤ theta p K :=
  div_nonneg (Finset.sum_nonneg fun _ _ => pow_nonneg (abs_nonneg _) K) (Nat.cast_nonneg p)

/-- The image of a homogeneous polynomial of degree `m` under a coefficient ring map is homogeneous
of degree `m`. -/
private theorem isHomogeneous_map {R S σ : Type*} [CommSemiring R] [CommSemiring S] (φ : R →+* S)
    {G : MvPolynomial σ R} {m : ℕ} (hG : G.IsHomogeneous m) : (G.map φ).IsHomogeneous m := by
  intro α hα
  exact hG fun h0 => hα (by rw [coeff_map, h0, map_zero])

/-- Every coefficient reduction of the random sign form is homogeneous of degree `d`. -/
private theorem isHomogeneous_map_signForm {S : Type*} [CommSemiring S]
    (ε : SignFamily (monomialsEq (n + 1) d)) (φ : ℤ →+* S) :
    ((signForm n d ε).map φ).IsHomogeneous d := by
  refine isHomogeneous_map φ ?_
  rw [signForm]
  refine (mem_homogeneousSubmodule _ _).1 (Submodule.sum_mem _ fun α hα => ?_)
  exact (mem_homogeneousSubmodule _ _).2 (isHomogeneous_monomial _ (mem_monomialsEq.1 hα))

/-- The reduction modulo `p` of the random sign form is nonzero: the coefficient of the pure power
`x₀^d` is a sign, and `±1 ≠ 0` in `𝔽ₚ`. -/
theorem map_signForm_ne_zero (ε : SignFamily (monomialsEq (n + 1) d)) :
    (signForm n d ε).map (Int.castRingHom (ZMod p)) ≠ 0 := by
  intro h
  have hc : ((signForm n d ε).map (Int.castRingHom (ZMod p))).coeff (Finsupp.single 0 d)
      = ((signOf ε (Finsupp.single (0 : Fin (n + 1)) d) : ℤ) : ZMod p) := by
    rw [coeff_map, coeff_signForm _ (Finsupp.degree_single 0 d)]
    rfl
  rw [h, coeff_zero] at hc
  rcases Int.units_eq_one_or (signOf ε (Finsupp.single (0 : Fin (n + 1)) d)) with hu | hu <;>
    rw [hu] at hc <;> simp [eq_comm] at hc

/-! ### Dehomogenization, derivatives and evaluation -/

/-- Dehomogenizing on the chart `x_i ≠ 0` commutes with differentiation in the remaining variables:
`∂_j (F(…, 1, …)) = (∂_{σ_i(j)}F)(…, 1, …)`, where `σ_i` lists the variables other than `x_i`. -/
theorem dehomogenize_pderiv (R : Type*) [CommRing R] (i : Fin (n + 1)) (j : Fin n)
    (F : MvPolynomial (Fin (n + 1)) R) :
    dehomogenize R i (pderiv (i.succAbove j) F) = pderiv j (dehomogenize R i F) := by
  have hX : ∀ l : Fin (n + 1),
      dehomogenize R i (pderiv (i.succAbove j) (X l)) = pderiv j (dehomogenize R i (X l)) := by
    intro l
    rcases eq_or_ne l i with rfl | hl
    · rw [pderiv_X_of_ne (Fin.succAbove_ne l j).symm]
      simp [dehomogenize]
    · obtain ⟨j', rfl⟩ := Fin.exists_succAbove_eq hl
      rcases eq_or_ne j' j with rfl | hj'
      · simp [dehomogenize]
      · rw [pderiv_X_of_ne fun h => hj' (Fin.succAbove_right_injective h)]
        simp [dehomogenize, pderiv_X_of_ne hj']
  induction F using MvPolynomial.induction_on with
  | C a => simp [dehomogenize]
  | add q r hq hr => simp [hq, hr]
  | mul_X q l hq =>
      rw [pderiv_mul, map_add, map_mul, map_mul, hq, hX l, map_mul, pderiv_mul]

/-- Evaluating the dehomogenization on the chart `x_i ≠ 0` at `a` is evaluating the form itself at
`a` with `1` inserted in position `i`, over any ring of coefficients. -/
theorem eval_map_dehomogenize {R S : Type*} [CommRing R] [CommRing S] (φ : R →+* S)
    (i : Fin (n + 1)) (a : Fin n → S) (F : MvPolynomial (Fin (n + 1)) R) :
    eval a ((dehomogenize R i F).map φ) = eval (Fin.insertNth i 1 a) (F.map φ) := by
  have h : ((eval a).comp (MvPolynomial.map φ)).comp (dehomogenize R i).toRingHom
      = (eval (Fin.insertNth i 1 a)).comp (MvPolynomial.map φ) := by
    refine MvPolynomial.ringHom_ext (fun r => ?_) fun l => ?_
    · simp [dehomogenize]
    · rcases eq_or_ne l i with rfl | hl
      · simp [dehomogenize]
      · obtain ⟨j, rfl⟩ := Fin.exists_succAbove_eq hl
        simp [dehomogenize]
  exact congrFun (congrArg (fun f : MvPolynomial (Fin (n + 1)) R →+* S => (f : _ → S)) h) F

/-! ### The Frobenius map on geometric points -/

/-- Raising every coordinate to the `p`-th power raises the value of a polynomial with `𝔽ₚ`
coefficients to the `p`-th power: the coefficients are fixed by the Frobenius. -/
theorem eval_pow_map_of_zmod {m : ℕ} (G : MvPolynomial (Fin m) (ZMod p))
    (v : Fin m → AlgebraicClosure (ZMod p)) :
    eval (fun l => v l ^ p) (G.map (algebraMap (ZMod p) (AlgebraicClosure (ZMod p))))
      = eval v (G.map (algebraMap (ZMod p) (AlgebraicClosure (ZMod p)))) ^ p := by
  have h : (eval fun l => v l ^ p).comp
        (MvPolynomial.map (algebraMap (ZMod p) (AlgebraicClosure (ZMod p))))
      = (frobenius (AlgebraicClosure (ZMod p)) p).comp
        ((eval v).comp (MvPolynomial.map (algebraMap (ZMod p) (AlgebraicClosure (ZMod p))))) := by
    refine MvPolynomial.ringHom_ext (fun r => ?_) fun l => ?_
    · simp [frobenius_def, ← map_pow, ZMod.pow_card]
    · simp [frobenius_def]
  have h' := congrFun (congrArg (fun f : MvPolynomial (Fin m) (ZMod p) →+*
    AlgebraicClosure (ZMod p) => (f : _ → AlgebraicClosure (ZMod p))) h) G
  simpa [frobenius_def] using h'

/-- **The singular locus is Frobenius stable.** For a nonzero homogeneous form with `𝔽ₚ`
coefficients the `p`-power map carries `Sing X_F` into itself: `F` and its first derivatives have
`𝔽ₚ` coefficients, so raising the coordinates to the `p`-th power raises their values to the `p`-th
power, and the values are `0`. -/
theorem mem_singularLocus_projPowMap (hjac : AffineJacobianCriterion.{0})
    {F : MvPolynomial (Fin (n + 1)) (ZMod p)} (hF : F ≠ 0)
    (hFd : F.IsHomogeneous d) {P : ProjPoint p n} (hP : P ∈ singularLocus F) :
    projPowMap p P ∈ singularLocus F := by
  set K := AlgebraicClosure (ZMod p) with hK
  have hne : (fun l => P.rep l ^ p) ≠ 0 := pow_ne_zero_of_ne_zero P.rep_nonzero
  obtain ⟨c, hc⟩ := Projectivization.exists_smul_eq_mk_rep K (fun l => P.rep l ^ p) hne
  have hrep : (projPowMap p P).rep = (c : K) • fun l => P.rep l ^ p := by
    rw [projPowMap_eq_mk P hne, ← hc]
    exact funext fun l => rfl
  have key : ∀ (m : ℕ) (G : MvPolynomial (Fin (n + 1)) (ZMod p)), G.IsHomogeneous m →
      eval P.rep (toClosure G) = 0 → eval (projPowMap p P).rep (toClosure G) = 0 := by
    intro m G hG h
    rw [hrep, toClosure, eval_smul_of_isHomogeneous (isHomogeneous_map _ hG),
      eval_pow_map_of_zmod G P.rep]
    rw [toClosure] at h
    rw [h, zero_pow (Fact.out (p := p.Prime)).ne_zero, mul_zero]
  rw [mem_singularLocus_iff hjac hF] at hP ⊢
  exact ⟨key d F hFd hP.1, fun l => key (d - 1) (pderiv l F) hFd.pderiv (hP.2 l)⟩

/-- The `p`-power map preserves the singular locus, hence so does each of its iterates. -/
theorem mem_singularLocus_iterate_projPowMap (hjac : AffineJacobianCriterion.{0})
    {F : MvPolynomial (Fin (n + 1)) (ZMod p)} (hF : F ≠ 0)
    (hFd : F.IsHomogeneous d) {P : ProjPoint p n} (hP : P ∈ singularLocus F) (j : ℕ) :
    (projPowMap p)^[j] P ∈ singularLocus F := by
  induction j with
  | zero => simpa using hP
  | succ j ih =>
      rw [Function.iterate_succ_apply']
      exact mem_singularLocus_projPowMap hjac hF hFd ih

/-! ### The degree of a closed point, read on a chart -/

/-- A point one of whose homogeneous coordinates is `1` is fixed by the `q`-power map exactly when
every coordinate satisfies `x^q = x`: the scalar relating the two representatives is read off at
that coordinate, and it is `1`. -/
theorem projPowMap_mk_eq_self_iff {q : ℕ} [NeZero q] {K : Type*} [Field K] {m : ℕ}
    {v : Fin (m + 1) → K} (hv : v ≠ 0) {i : Fin (m + 1)} (hvi : v i = 1) :
    projPowMap q (Projectivization.mk K v hv) = Projectivization.mk K v hv ↔
      ∀ l, v l ^ q = v l := by
  have hvq : (fun l => v l ^ q) ≠ 0 := pow_ne_zero_of_ne_zero hv
  rw [projPowMap_mk hv hvq, Projectivization.mk_eq_mk_iff]
  constructor
  · rintro ⟨a, ha⟩
    have hai : (a : K) = 1 := by
      have h1 := congrFun ha i
      simpa [Units.smul_def, hvi] using h1
    intro l
    have h2 := congrFun ha l
    rw [Pi.smul_apply, Units.smul_def, hai, one_smul] at h2
    exact h2.symm
  · exact fun h => ⟨1, funext fun l => by simp [h l]⟩

/-- **A closed point of `ℙⁿ` of degree `e`, read on a standard chart.** Let `P` be a geometric
point of `ℙⁿ` whose Frobenius orbit has length `e`, let `x_i` be a nonvanishing homogeneous
coordinate of `P` and let `x_j`, `j ≠ i`, be another one. Normalizing `x_i` to `1` and deleting it
gives an affine geometric point `a`, not the origin, lying over a closed point of `𝔸ⁿ_{𝔽ₚ}` of
degree exactly `e`.

The residue field is the subalgebra `𝔽ₚ[a₁, …, a_n]` of `𝔽̄ₚ`. It sits inside `𝔽_{p^e}` because `P`
is fixed by the `p^e`-power map, which forces `m ≤ e` for its degree `m`; conversely all its
elements satisfy `x^{p^m} = x`, so `P` is fixed by the `p^m`-power map and `e ≤ m` by minimality of
the orbit length. -/
theorem exists_affineClosedPoint_of_projPoint {P : ProjPoint p n} {e : ℕ}
    (hPe : Function.minimalPeriod (projPowMap p) P = e) (he : 1 ≤ e) {i j : Fin (n + 1)}
    (hi : P.rep i ≠ 0) (hj : j ≠ i) (hjne : P.rep j ≠ 0) :
    ∃ (a : Fin n → AlgebraicClosure (ZMod p))
      (Q : MaximalSpectrum (MvPolynomial (Fin n) (ZMod p))) (i₀ : Fin n),
      Fin.insertNth i 1 a = (P.rep i)⁻¹ • P.rep ∧ pointDegree (ZMod p) Q = e ∧
        evalAt Q (X i₀) ≠ 0 ∧
        ∀ f ∈ Q.asIdeal,
          eval a (f.map (algebraMap (ZMod p) (AlgebraicClosure (ZMod p)))) = 0 := by
  classical
  set K := AlgebraicClosure (ZMod p) with hK
  have hp2 : 2 ≤ p := (Fact.out (p := p.Prime)).two_le
  set v : Fin (n + 1) → K := (P.rep i)⁻¹ • P.rep with hvdef
  have hvi : v i = 1 := by
    rw [hvdef]
    exact inv_mul_cancel₀ hi
  have hv0 : v ≠ 0 := fun h => one_ne_zero (hvi ▸ congrFun h i)
  have hmkv : Projectivization.mk K v hv0 = P := by
    rw [← Projectivization.mk_rep P]
    refine (Projectivization.mk_eq_mk_iff K _ _ _ _).2 ⟨Units.mk0 _ (inv_ne_zero hi), ?_⟩
    exact funext fun l => rfl
  set a : Fin n → K := Fin.removeNth i v with hadef
  have hins : Fin.insertNth i 1 a = v := by
    rw [hadef, ← hvi]
    exact Fin.insertNth_self_removeNth i v
  have hfixv : ∀ l, v l ^ p ^ e = v l := by
    have h1 : Function.IsPeriodicPt (projPowMap p) e P :=
      hPe ▸ Function.isPeriodicPt_minimalPeriod (projPowMap p) P
    rw [Function.IsPeriodicPt, Function.IsFixedPt, iterate_projPowMap, ← hmkv] at h1
    exact (projPowMap_mk_eq_self_iff hv0 hvi).1 h1
  have hfixa : ∀ l, a l ^ p ^ e = a l := fun l => hfixv (i.succAbove l)
  set ψ : MvPolynomial (Fin n) (ZMod p) →ₐ[ZMod p] K := aeval a with hψ
  set A := ψ.range with hA
  have hsub : (A : Set K) ⊆ (frobFixedField p e : Set K) := by
    intro x hx
    rw [SetLike.mem_coe, hA, AlgHom.mem_range] at hx
    obtain ⟨f, rfl⟩ := hx
    rw [SetLike.mem_coe, mem_frobFixedField]
    induction f using MvPolynomial.induction_on with
    | C c => rw [hψ, aeval_C, ← map_pow, ZMod.pow_card_pow]
    | add q r hq hr => rw [map_add, add_pow_char_pow, hq, hr]
    | mul_X q l hq => rw [map_mul, mul_pow, hq, hψ, aeval_X, hfixa l]
  obtain ⟨hfin, hcard⟩ := finite_and_card_frobFixedField_le (p := p) (e := e) he
  have hAfin : (A : Set K).Finite := hfin.subset hsub
  have : Finite A := hAfin.to_subtype
  have hAfield : IsField A := Finite.isField_of_domain A
  let : Field A := hAfield.toField
  have : Fintype A := Fintype.ofFinite A
  have hequiv : (MvPolynomial (Fin n) (ZMod p) ⧸ RingHom.ker ψ) ≃ₐ[ZMod p] A :=
    Ideal.quotientKerEquivRange ψ
  have hImax : (RingHom.ker (ψ : MvPolynomial (Fin n) (ZMod p) →+* K)).IsMaximal :=
    Ideal.Quotient.maximal_of_isField _ (MulEquiv.isField hAfield hequiv.toMulEquiv)
  set Q : MaximalSpectrum (MvPolynomial (Fin n) (ZMod p)) := ⟨RingHom.ker ψ, hImax⟩ with hQ
  set m := Module.finrank (ZMod p) A with hm
  have hdegQ : pointDegree (ZMod p) Q = m := hequiv.toLinearEquiv.finrank_eq
  have hcardA : Fintype.card A = p ^ m := by
    rw [Module.card_eq_pow_finrank (K := ZMod p) (V := A), ZMod.card]
  have hme : m ≤ e := by
    have hp1 : 1 < p := by omega
    refine (Nat.pow_le_pow_iff_right hp1).1 ?_
    calc p ^ m = Nat.card A := by rw [← hcardA, Nat.card_eq_fintype_card]
      _ = (A : Set K).ncard := Nat.card_coe_set_eq _
      _ ≤ (frobFixedField p e : Set K).ncard := Set.ncard_le_ncard hsub hfin
      _ = Nat.card (frobFixedField p e) := (Nat.card_coe_set_eq _).symm
      _ ≤ p ^ e := hcard
  have hem : e ≤ m := by
    have hm0 : 0 < m := by
      rcases Nat.eq_zero_or_pos m with h0 | h0
      · exact absurd (Fintype.card_le_one_iff_subsingleton.1 (by rw [hcardA, h0, pow_zero]))
          (not_subsingleton A)
      · exact h0
    have hfixA : ∀ l, a l ^ p ^ m = a l := by
      intro l
      have hmem : a l ∈ A := ⟨X l, by simp [hψ]⟩
      have h1 : (⟨a l, hmem⟩ : A) ^ p ^ m = ⟨a l, hmem⟩ := by
        rw [← hcardA]; exact FiniteField.pow_card _
      have h2 := congrArg (fun x : A => (x : K)) h1
      simpa using h2
    have h3 : Function.IsPeriodicPt (projPowMap p) m P := by
      rw [Function.IsPeriodicPt, Function.IsFixedPt, iterate_projPowMap, ← hmkv]
      refine (projPowMap_mk_eq_self_iff hv0 hvi).2 fun l => ?_
      rcases eq_or_ne l i with rfl | hl
      · rw [hvi, one_pow]
      · obtain ⟨l', rfl⟩ := Fin.exists_succAbove_eq hl
        exact hfixA l'
    rw [← hPe]
    exact h3.minimalPeriod_le hm0
  obtain ⟨j₀, hj₀⟩ := Fin.exists_succAbove_eq hj
  have haj₀ : a j₀ ≠ 0 := by
    rw [hadef, Fin.removeNth_apply, hj₀, hvdef]
    exact mul_ne_zero (inv_ne_zero hi) hjne
  refine ⟨a, Q, j₀, hins, by rw [hdegQ]; omega, ?_, fun f hf => ?_⟩
  · rw [evalAt, Ne, Ideal.Quotient.eq_zero_iff_mem, hQ]
    intro hmem
    rw [RingHom.mem_ker] at hmem
    exact haj₀ (by rw [← aeval_X (R := ZMod p) a j₀]; exact hmem)
  · have h1 : ψ f = 0 := RingHom.mem_ker.1 hf
    rw [hψ, aeval_def, eval₂_eq_eval_map] at h1
    exact h1

/-! ### The probability of singularity at a prescribed closed point of `ℙⁿ` -/

/-- **The probability of singularity at a prescribed closed point of `ℙⁿ`.** Let `P` be a geometric
point of `ℙⁿ` whose Frobenius orbit has length `e ≥ 1`, and let `(n+1)e ≤ d + 1`. Then `X_{f̄}` is
singular at `P` with probability at most `Θ_{K_e}(p)^{(n+1)e}`.

If `P` is a coordinate vertex the event is empty, by `notMem_hypersurface_map_signForm`. Otherwise
`P` has two nonzero homogeneous coordinates, and `exists_affineClosedPoint_of_projPoint` presents
it on one standard chart as a closed point of `𝔸ⁿ_{𝔽ₚ}` of degree `e` that is not the origin. There
`f̄` dehomogenizes to the affine sign polynomial (`dehomogenize_map_signForm`) along a reindexing
of the signs that preserves their law (`measurePreserving_signFamilyCongr`), and
`signMeasure_mem_affineSingularLocus_affineSignPoly_le` applies with `K = K_e`, which is positive
and satisfies `K_e (n+1) e ≤ d + 1` by definition of the floor. -/
theorem signMeasure_mem_singularLocus_map_signForm_le (hjac : AffineJacobianCriterion.{0})
    (P : ProjPoint p n) {e : ℕ}
    (hPe : Function.minimalPeriod (projPowMap p) P = e) (he : 1 ≤ e)
    (hed : (n + 1) * e ≤ d + 1) :
    signMeasure ↥(monomialsEq (n + 1) d)
        {ε | P ∈ singularLocus ((signForm n d ε).map (Int.castRingHom (ZMod p)))}
      ≤ ENNReal.ofReal (theta p (basisCount n d e) ^ ((n + 1) * e)) := by
  classical
  by_cases hvert : ∃ i : Fin (n + 1), ∀ j, j ≠ i → P.rep j = 0
  · obtain ⟨i, hi⟩ := hvert
    have hempty : {ε : SignFamily (monomialsEq (n + 1) d) |
        P ∈ singularLocus ((signForm n d ε).map (Int.castRingHom (ZMod p)))} = ∅ :=
      Set.eq_empty_iff_forall_notMem.2 fun ε hε =>
        notMem_hypersurface_map_signForm ε hi (singularLocus_subset_hypersurface _ hε)
    rw [hempty, measure_empty]
    exact zero_le
  push Not at hvert
  obtain ⟨i, hi⟩ : ∃ i : Fin (n + 1), P.rep i ≠ 0 := by
    by_contra hcon
    push Not at hcon
    exact P.rep_nonzero (funext hcon)
  obtain ⟨j, hj, hjne⟩ := hvert i
  obtain ⟨a, Q, i₀, hins, hdeg, hi₀, ha⟩ :=
    exists_affineClosedPoint_of_projPoint hPe he hi hj hjne
  have hne0 : 0 < (n + 1) * e := by positivity
  have hK : 0 < basisCount n d e := (Nat.one_le_div_iff hne0).2 hed
  have hKd : basisCount n d e * ((n + 1) * pointDegree (ZMod p) Q) ≤ d + 1 := by
    rw [hdeg, basisCount]
    exact Nat.div_mul_le_self _ _
  set Φ := (chartTupleEquiv d i).arrowCongr (Equiv.refl ℤˣ) with hΦdef
  have hΦ : MeasurePreserving Φ (signMeasure ↥(monomialsEq (n + 1) d))
      (signMeasure ↥(monomialsLE n d)) := measurePreserving_signFamilyCongr _
  have hsub : {ε : SignFamily (monomialsEq (n + 1) d) |
        P ∈ singularLocus ((signForm n d ε).map (Int.castRingHom (ZMod p)))}
      ⊆ Φ ⁻¹' {δ : SignFamily (monomialsLE n d) |
        a ∈ affineSingularLocus (affineSignPoly p n d δ)} := by
    intro ε hε
    rw [Set.mem_ofPred_eq, mem_singularLocus_iff hjac (map_signForm_ne_zero ε)] at hε
    have hscale : ∀ (mm : ℕ) (G : MvPolynomial (Fin (n + 1)) (ZMod p)), G.IsHomogeneous mm →
        eval P.rep (toClosure G) = 0 →
        eval (Fin.insertNth i 1 a)
          (G.map (algebraMap (ZMod p) (AlgebraicClosure (ZMod p)))) = 0 := by
      intro mm G hG h
      rw [hins, eval_smul_of_isHomogeneous
        (isHomogeneous_map (algebraMap (ZMod p) (AlgebraicClosure (ZMod p))) hG)]
      rw [toClosure] at h
      rw [h, mul_zero]
    have hgne : dehomogenize (ZMod p) i ((signForm n d ε).map (Int.castRingHom (ZMod p))) ≠ 0 := by
      rw [dehomogenize_map_signForm i ε]
      exact affineSignPoly_ne_zero _
    have hmem : a ∈ affineSingularLocus
        (dehomogenize (ZMod p) i ((signForm n d ε).map (Int.castRingHom (ZMod p)))) := by
      rw [mem_affineSingularLocus_iff hjac hgne]
      refine ⟨?_, fun j' => ?_⟩
      · rw [eval_map_dehomogenize]
        exact hscale d _ (isHomogeneous_map_signForm ε _) hε.1
      · rw [← dehomogenize_pderiv, eval_map_dehomogenize]
        exact hscale (d - 1) _ (isHomogeneous_map_signForm ε _).pderiv (hε.2 _)
    rw [Set.mem_preimage, Set.mem_ofPred_eq, ← dehomogenize_map_signForm i ε]
    exact hmem
  calc signMeasure ↥(monomialsEq (n + 1) d)
        {ε | P ∈ singularLocus ((signForm n d ε).map (Int.castRingHom (ZMod p)))}
      ≤ signMeasure ↥(monomialsEq (n + 1) d)
          (Φ ⁻¹' {δ | a ∈ affineSingularLocus (affineSignPoly p n d δ)}) := measure_mono hsub
    _ = signMeasure ↥(monomialsLE n d) {δ | a ∈ affineSingularLocus (affineSignPoly p n d δ)} :=
        hΦ.measure_preimage (MeasurableSet.of_discrete).nullMeasurableSet
    _ ≤ ENNReal.ofReal (theta p (basisCount n d e) ^ ((n + 1) * pointDegree (ZMod p) Q)) :=
        signMeasure_mem_affineSingularLocus_affineSignPoly_le hjac Q hi₀ hK hKd ha
    _ = ENNReal.ofReal (theta p (basisCount n d e) ^ ((n + 1) * e)) := by rw [hdeg]

/-! ### One representative per closed point -/

/-- **One geometric point per closed point of degree `e`.** The closed points of `ℙⁿ_{𝔽ₚ}` of
degree `e` are the orbits of length `e` of the `p`-power map, and there are `C_e` of them; choosing
one point in each gives a set of `C_e` geometric points, each with orbit length `e`, meeting every
such orbit. The set is finite because the points it contains are fixed by the `p^e`-power map. -/
theorem exists_finset_reps_closedPoints (p n : ℕ) [Fact p.Prime] {e : ℕ} (he : 1 ≤ e) :
    ∃ T : Finset (ProjPoint p n), T.card = closedPointCount p n e ∧
      (∀ Q ∈ T, Function.minimalPeriod (projPowMap p) Q = e) ∧
      ∀ P : ProjPoint p n, Function.minimalPeriod (projPowMap p) P = e →
        ∃ Q ∈ T, ∃ j, (projPowMap p)^[j] P = Q := by
  classical
  have : NeZero p := ⟨(Fact.out (p := p.Prime)).ne_zero⟩
  set C := {c : Cycle (ProjPoint p n) // ∃ P : ProjPoint p n,
      Function.minimalPeriod (projPowMap p) P = e ∧
        c = Function.periodicOrbit (projPowMap p) P} with hC
  have hCcard : closedPointCount p n e = Nat.card C := rfl
  set ρ : C → ProjPoint p n := fun c => c.2.choose with hρ
  have hρper : ∀ c : C, Function.minimalPeriod (projPowMap p) (ρ c) = e := fun c =>
    c.2.choose_spec.1
  have hρcyc : ∀ c : C, (c : Cycle (ProjPoint p n))
      = Function.periodicOrbit (projPowMap p) (ρ c) := fun c => c.2.choose_spec.2
  have hρinj : Function.Injective ρ := fun c c' h =>
    Subtype.ext (by rw [hρcyc c, hρcyc c', h])
  have hρmem : ∀ c : C, ρ c ∈ Function.periodicPts (projPowMap p) := fun c =>
    Function.mem_periodicPts.2 ⟨e, by omega, by
      have h := Function.isPeriodicPt_minimalPeriod (projPowMap p) (ρ c)
      rwa [hρper c] at h⟩
  have hρfix : ∀ c : C, projPowMap (p ^ e) (ρ c) = ρ c := by
    intro c
    have h := Function.isPeriodicPt_minimalPeriod (projPowMap p) (ρ c)
    rwa [hρper c, Function.IsPeriodicPt, Function.IsFixedPt, iterate_projPowMap] at h
  obtain ⟨hFixfin, -⟩ := finite_and_ncard_setOf_projPowMap_eq_le (p := p) (n := n) (e := e) he
  have : Finite ↥{P : ProjPoint p n | projPowMap (p ^ e) P = P} := hFixfin.to_subtype
  have : Finite C :=
    Finite.of_injective
      (fun c : C => (⟨ρ c, hρfix c⟩ : ↥{P : ProjPoint p n | projPowMap (p ^ e) P = P}))
      fun c c' h => hρinj (congrArg Subtype.val h)
  have : Fintype C := Fintype.ofFinite C
  refine ⟨Finset.image ρ Finset.univ, ?_, ?_, ?_⟩
  · rw [Finset.card_image_of_injective _ hρinj, Finset.card_univ, hCcard, Nat.card_eq_fintype_card]
  · intro Q hQ
    obtain ⟨c, -, rfl⟩ := Finset.mem_image.1 hQ
    exact hρper c
  · intro P hP
    obtain ⟨c, hc⟩ : ∃ c : C,
        (c : Cycle (ProjPoint p n)) = Function.periodicOrbit (projPowMap p) P :=
      ⟨⟨Function.periodicOrbit (projPowMap p) P, ⟨P, hP, rfl⟩⟩, rfl⟩
    refine ⟨ρ c, Finset.mem_image.2 ⟨c, Finset.mem_univ c, rfl⟩, ?_⟩
    have hmemP : P ∈ Function.periodicPts (projPowMap p) :=
      Function.mem_periodicPts.2 ⟨e, by omega, by
        have h := Function.isPeriodicPt_minimalPeriod (projPowMap p) P
        rwa [hP] at h⟩
    refine (Function.mem_periodicOrbit_iff hmemP).1 ?_
    rw [← hc, hρcyc c]
    exact Function.self_mem_periodicOrbit (hρmem c)

/-! ### The union bound over the closed points of small degree -/

/-- **Contribution of the closed points of small degree.** For `R ≤ ⌊(d+1)/(n+1)⌋` the probability
that `X_{f̄}` is singular at some closed point of `ℙⁿ_{𝔽ₚ}` of degree at most `R` is at most
`(p/(p-1)) ∑_{e=1}^R (p^{ne}/e) Θ_{K_e}(p)^{(n+1)e}`.

A closed point of degree `e` is an orbit of length `e` of the `p`-power map on `ℙⁿ(𝔽̄ₚ)`, so the
event is that some geometric point whose orbit has length between `1` and `R` is singular; a point
of orbit length `0` is not periodic and lies in no closed point. Fix `e` with `1 ≤ e ≤ R`: then
`(n+1)e ≤ (n+1)R ≤ d+1`, so `K_e ≥ 1` and `(n+1)e K_e ≤ d+1`. Since the singular locus is stable
under the `p`-power map (`mem_singularLocus_projPowMap`) it suffices to test the one point per
orbit that `exists_finset_reps_closedPoints` selects, and a union bound over the `C_e` closed
points of degree `e` and then over `1 ≤ e ≤ R` reduces the estimate to
`signMeasure_mem_singularLocus_map_signForm_le` at each of them. Finally `C_e ≤ (p/(p-1)) p^{ne}/e`
gives the stated form. When `R = 0` the sum is empty and the bound is `0`, there being no closed
point of degree at most `0`. -/
@[browning_sawin "prop_low_degree"]
theorem signMeasure_exists_closedPoint_mem_singularLocus_le (hjac : AffineJacobianCriterion.{0})
    (p n d R : ℕ) [Fact p.Prime]
    (hR : R ≤ (d + 1) / (n + 1)) :
    signMeasure ↥(monomialsEq (n + 1) d)
        {ε | ∃ P : ProjPoint p n, 1 ≤ Function.minimalPeriod (projPowMap p) P ∧
          Function.minimalPeriod (projPowMap p) P ≤ R ∧
          P ∈ singularLocus ((signForm n d ε).map (Int.castRingHom (ZMod p)))}
      ≤ ENNReal.ofReal ((p : ℝ) / (p - 1) * ∑ e ∈ Finset.Icc 1 R,
          (p : ℝ) ^ (n * e) / e * theta p (basisCount n d e) ^ ((n + 1) * e)) := by
  classical
  have hp2 : 2 ≤ p := (Fact.out (p := p.Prime)).two_le
  have hpR : (2 : ℝ) ≤ (p : ℝ) := by exact_mod_cast hp2
  have hp1 : (0 : ℝ) < (p : ℝ) - 1 := by linarith
  have hreps : ∀ e : ℕ, ∃ T : Finset (ProjPoint p n), 1 ≤ e →
      T.card = closedPointCount p n e ∧
        (∀ Q ∈ T, Function.minimalPeriod (projPowMap p) Q = e) ∧
        ∀ P : ProjPoint p n, Function.minimalPeriod (projPowMap p) P = e →
          ∃ Q ∈ T, ∃ j, (projPowMap p)^[j] P = Q := by
    intro e
    by_cases he : 1 ≤ e
    · obtain ⟨T, hT⟩ := exists_finset_reps_closedPoints p n he
      exact ⟨T, fun _ => hT⟩
    · exact ⟨∅, fun h => absurd h he⟩
  choose T hT using hreps
  have hed : ∀ e ∈ Finset.Icc 1 R, (n + 1) * e ≤ d + 1 := by
    intro e he
    rw [Finset.mem_Icc] at he
    calc (n + 1) * e ≤ (n + 1) * ((d + 1) / (n + 1)) := Nat.mul_le_mul_left _ (he.2.trans hR)
      _ ≤ d + 1 := Nat.mul_div_le _ _
  have hcover : {ε : SignFamily (monomialsEq (n + 1) d) |
        ∃ P : ProjPoint p n, 1 ≤ Function.minimalPeriod (projPowMap p) P ∧
          Function.minimalPeriod (projPowMap p) P ≤ R ∧
          P ∈ singularLocus ((signForm n d ε).map (Int.castRingHom (ZMod p)))}
      ⊆ ⋃ e ∈ Finset.Icc 1 R, ⋃ Q ∈ T e,
          {ε : SignFamily (monomialsEq (n + 1) d) |
            Q ∈ singularLocus ((signForm n d ε).map (Int.castRingHom (ZMod p)))} := by
    rintro ε ⟨P, h1, h2, h3⟩
    obtain ⟨-, -, hmeet⟩ := hT _ h1
    obtain ⟨Q, hQT, jj, hjj⟩ := hmeet P rfl
    refine Set.mem_iUnion₂.2 ⟨_, Finset.mem_Icc.2 ⟨h1, h2⟩, Set.mem_iUnion₂.2 ⟨Q, hQT, ?_⟩⟩
    exact hjj ▸ mem_singularLocus_iterate_projPowMap hjac (map_signForm_ne_zero ε)
      (isHomogeneous_map_signForm ε _) h3 jj
  refine le_trans (measure_mono hcover) (le_trans (measure_biUnion_finset_le _ _) ?_)
  calc ∑ e ∈ Finset.Icc 1 R, signMeasure ↥(monomialsEq (n + 1) d) (⋃ Q ∈ T e,
          {ε : SignFamily (monomialsEq (n + 1) d) |
            Q ∈ singularLocus ((signForm n d ε).map (Int.castRingHom (ZMod p)))})
      ≤ ∑ e ∈ Finset.Icc 1 R, ENNReal.ofReal ((p : ℝ) / (p - 1) *
          ((p : ℝ) ^ (n * e) / e * theta p (basisCount n d e) ^ ((n + 1) * e))) := by
        refine Finset.sum_le_sum fun e he => ?_
        obtain ⟨hcard, hdegT, -⟩ := hT e (Finset.mem_Icc.1 he).1
        have hθ : (0 : ℝ) ≤ theta p (basisCount n d e) ^ ((n + 1) * e) :=
          pow_nonneg (theta_nonneg p _) _
        calc signMeasure ↥(monomialsEq (n + 1) d) (⋃ Q ∈ T e,
                {ε : SignFamily (monomialsEq (n + 1) d) |
                  Q ∈ singularLocus ((signForm n d ε).map (Int.castRingHom (ZMod p)))})
            ≤ ∑ Q ∈ T e, signMeasure ↥(monomialsEq (n + 1) d)
                {ε | Q ∈ singularLocus ((signForm n d ε).map (Int.castRingHom (ZMod p)))} :=
              measure_biUnion_finset_le _ _
          _ ≤ ∑ _Q ∈ T e, ENNReal.ofReal (theta p (basisCount n d e) ^ ((n + 1) * e)) :=
              Finset.sum_le_sum fun Q hQ => signMeasure_mem_singularLocus_map_signForm_le hjac Q
                (hdegT Q hQ) (Finset.mem_Icc.1 he).1 (hed e he)
          _ = (closedPointCount p n e : ℝ≥0∞) *
                ENNReal.ofReal (theta p (basisCount n d e) ^ ((n + 1) * e)) := by
              rw [Finset.sum_const, hcard, nsmul_eq_mul]
          _ = ENNReal.ofReal ((closedPointCount p n e : ℝ) *
                theta p (basisCount n d e) ^ ((n + 1) * e)) := by
              rw [ENNReal.ofReal_mul (Nat.cast_nonneg _), ENNReal.ofReal_natCast]
          _ ≤ ENNReal.ofReal ((p : ℝ) / (p - 1) *
                ((p : ℝ) ^ (n * e) / e * theta p (basisCount n d e) ^ ((n + 1) * e))) := by
              refine ENNReal.ofReal_le_ofReal ?_
              calc (closedPointCount p n e : ℝ) * theta p (basisCount n d e) ^ ((n + 1) * e)
                  ≤ ((p : ℝ) / (p - 1) * (p : ℝ) ^ (n * e) / e) *
                      theta p (basisCount n d e) ^ ((n + 1) * e) :=
                    mul_le_mul_of_nonneg_right
                      (closedPointCount_le_div n (Finset.mem_Icc.1 he).1) hθ
                _ = (p : ℝ) / (p - 1) * ((p : ℝ) ^ (n * e) / e *
                      theta p (basisCount n d e) ^ ((n + 1) * e)) := by ring
    _ = ENNReal.ofReal (∑ e ∈ Finset.Icc 1 R, (p : ℝ) / (p - 1) *
          ((p : ℝ) ^ (n * e) / e * theta p (basisCount n d e) ^ ((n + 1) * e))) := by
        refine (ENNReal.ofReal_sum_of_nonneg fun e he => ?_).symm
        exact mul_nonneg (div_nonneg (Nat.cast_nonneg p) hp1.le)
          (mul_nonneg (div_nonneg (by positivity) (Nat.cast_nonneg e))
            (pow_nonneg (theta_nonneg p _) _))
    _ = ENNReal.ofReal ((p : ℝ) / (p - 1) * ∑ e ∈ Finset.Icc 1 R,
          (p : ℝ) ^ (n * e) / e * theta p (basisCount n d e) ^ ((n + 1) * e)) := by
        rw [Finset.mul_sum]

end LowDegree

end BrowningSawin
